@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <!--font-awsome -->
    <link href="~/assets/css/all.css" rel="stylesheet">
    <!-- custom CSS -->
    <link rel="stylesheet" href="~/assets/css/custom.css">
    <link rel="icon" type="image/png" href="~/assets/images/favicon.ico" sizes="16x16">
    <title>Link Expired</title>
</head>
<body class="bg-hotel">

    <div class="header-top">
        <img src="~/assets/images/logo.png" />

    </div>
    <div class="container thank">
        <div class="imge-thank">

            <img src="~/assets/images/thank.svg" />
        </div>
        <p>This link has either been consumed or has <span>expired.</span> If you haven't completed the process,<br> please contact hotel guest reservations for assistance.</p>
    </div>

    <!-- Optional JavaScript -->
    <!-- jQuery first, then Popper.js, then Bootstrap JS -->

    <script src="~/assets/js/jquery-3.5.1.slim.min.js"></script>
    <script src="~/assets/js/bootstrap.bundle.js"></script>
    <script src="~/assets/js/app.js"></script>
</body>
</html>