@{
    Layout = null;
    ViewBag.Title = "Search Reservation";
    var asm = typeof(CheckinPortal.MvcApplication).Assembly;
    string appVersion = asm.GetName().Version != null ? asm.GetName().Version.ToString() : "1.0.0.0";
    var infoAttrs = asm.GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false);
    if (infoAttrs != null && infoAttrs.Length > 0)
    {
        var infoVer = ((System.Reflection.AssemblyInformationalVersionAttribute)infoAttrs[0]).InformationalVersion;
        if (!string.IsNullOrWhiteSpace(infoVer))
        {
            appVersion = infoVer;
        }
    }
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <link rel="icon" type="image/png" href="~/assets/images/logo.png" sizes="16x16">
    <link rel="shortcut icon" type="image/png" href="~/assets/images/logo.png">
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link href="~/assets/css/all.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/custom.css?v=1.0.0.8">
    <title>Search Reservation</title>
</head>
<body class="search-reservation-page">
    <div class="container-fluid p-0 search-reservation-wrap" id="divSplash">
        <div class="header">
            <img class="img-fluid" src="~/assets/images/logo.png" alt="Niva Kuramathi">
        </div>
        <div class="layout-inro1 search-reservation-bg">
            <div class="search-container">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-10 col-lg-8">
                        <label class="search-field-label" for="confirmation-number">Enter confirmation, reservation, or OTA booking number</label>
                        <input type="text"
                               class="search-input"
                               id="confirmation-number"
                               name="ConfirmationNo"
                               maxlength="40"
                               autocomplete="off"
                               spellcheck="false"
                               placeholder="Booking number" />
                    </div>
                    <div class="col-12">
                        <a class="search-button m-2 align-middle" id="search-button" href="#" onclick="searchConfirmation(); return false;">SEARCH</a>
                    </div>
                </div>
                <div>
                    <span class="searchError" id="searchError" style="display:none;"></span>
                </div>
            </div>
        </div>
        <footer class="search-reservation-footer">
            Powered by Dots · © 2026. All rights reserved. Version @appVersion
        </footer>
    </div>

    <div class="loader-screen" style="display:none;z-index:99999">
        <div class="loadingio-spinner-pulse-yd5dl03y9fi">
            <div class="ldio-v55tnqe6ie">
                <div></div><div></div><div></div>
            </div>
        </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="~/assets/js/bootstrap.bundle.js"></script>
    <script type="text/javascript">
        (function () {
            var MAX_LEN = 40;
            var ALLOWED = /[^a-zA-Z0-9\-]/g;
            var INVALID_MSG = "Please enter a valid confirmation, reservation, or OTA booking number.";
            var EMPTY_MSG = "Please enter a confirmation, reservation, or OTA booking number.";

            function sanitizeValue(value) {
                return (value || "").replace(ALLOWED, "").substring(0, MAX_LEN);
            }

            function showError(message) {
                $(".searchError").text(message).show();
            }

            function showLoader() {
                $(".loader-screen").stop(true, true).fadeIn(100);
            }

            function hideLoader() {
                $(".loader-screen").stop(true, true).fadeOut(500);
            }

            // bfcache / Back restore: never leave the spinner stuck after QR → portal redirect
            window.addEventListener("pageshow", function () {
                hideLoader();
            });

            $("#confirmation-number").on("input paste", function () {
                var input = this;
                setTimeout(function () {
                    var cleaned = sanitizeValue(input.value);
                    if (input.value !== cleaned) {
                        input.value = cleaned;
                    }
                }, 0);
            });

            $("#confirmation-number").on("keypress", function (e) {
                var key = e.which || e.keyCode;
                if (key === 13) {
                    e.preventDefault();
                    searchConfirmation();
                    return false;
                }
                var ch = String.fromCharCode(key);
                if (!/[a-zA-Z0-9\-]/.test(ch)) {
                    e.preventDefault();
                    return false;
                }
            });

            window.searchConfirmation = function () {
                var confirmationNumber = sanitizeValue($("#confirmation-number").val()).trim();
                $("#confirmation-number").val(confirmationNumber);

                if (confirmationNumber === "") {
                    showError(EMPTY_MSG);
                    return;
                }

                if (confirmationNumber.length > MAX_LEN || !/^[a-zA-Z0-9\-]+$/.test(confirmationNumber)) {
                    showError(INVALID_MSG);
                    return;
                }

                var keepLoaderVisible = false;
                showLoader();
                $(".searchError").hide();

                $.ajax({
                    url: '@Url.Action("SearchReservation", "Home")',
                    type: "POST",
                    data: { ConfirmationNo: confirmationNumber },
                    success: function (response) {
                        if (response.result && response.redirectUrl) {
                            // Keep overlay visible during navigate; replace avoids Back → loader hang
                            keepLoaderVisible = true;
                            window.location.replace(response.redirectUrl);
                            return;
                        }
                        showError(
                            (response && response.errorMessage) || "Reservation not found."
                        );
                    },
                    error: function () {
                        showError("An error occurred while searching for the reservation.");
                    },
                    complete: function () {
                        if (!keepLoaderVisible) {
                            hideLoader();
                        }
                    }
                });
            };
        })();
    </script>
</body>
</html>
