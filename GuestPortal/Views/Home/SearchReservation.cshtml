
@{
    ViewBag.Title = "SearchReservation";
}
<title>QR Scan</title>
<style type="text/css">

    .search-container
    {
        position: absolute;
        top: 150px;
        left: 50%;
        /*top: 50%;*/
        transform: translateX(-50%);
        text-align: center;
    }

    .search-label
    {
        color: white;
        font-weight: bold;
        margin-right: 10px;
    }

    .search-container .search-input
    {
        padding: 10px 20px;
        border: 1px solid #ccc;
        margin-right: 10px;
        width: 285px; /* Set desired width */
    }

    .search-container .search-button
    {
        text-align: center;
        display: block;
        padding: 10px 20px;
        background-color: #f26122;
        -webkit-box-shadow: -3px 9px 39px -3px rgba(0,0,0,0.75);
        -moz-box-shadow: -3px 9px 39px -3px rgba(0,0,0,0.75);
        box-shadow: -3px 9px 39px -3px rgba(0,0,0,0.75);
        max-width: 130px;
        color: #fff;
        text-transform: uppercase;
        /* margin-top: auto;*/
        font-weight: 500;
        font-size: 18px;
    }

        .search-container .search-button:hover
        {
            text-decoration: none;
            background: #da5219;
            color: #fff;
        }
</style>


<div class="container-fluid p-0" id="divSplash" style="">
    <div class="header">
        <img class="img-fluid" src="~/assets/images/logo.png">
    </div>
    <div class="layout-inro1">

        <div class="search-container">
            <div class="row">
                @*<label for="confirmation-number" style="color: white; font-weight: bold;">Confirmation Number</label>*@
                <div>
                    <input type="text" class="search-input m-2" id="confirmation-number" placeholder="Enter confirmation number" />
                </div>
                <div>
                    <a class="search-button m-2 align-middle" id="search-button" style="width:auto" onclick="searchConfirmation()" href="#">SEARCH</a>
                </div>
            </div>
            <div>
                <span class="searchError" id="searchError" style="display:none; color:red;"></span>
            </div>

        </div>

    </div>
</div>

<div class="loader-screen" style="display:none;z-index:99999">
    <div class="loadingio-spinner-pulse-yd5dl03y9fi">
        <div class="ldio-v55tnqe6ie">
            <div></div><div></div><div></div>
        </div>
    </div>
</div>


<script type="text/javascript">

    function searchConfirmation() {
            var confirmationNumber = $("#confirmation-number").val();

            if (confirmationNumber.trim() === "") {
                //alert("Please enter a confirmation number.");
                $(".searchError").text("Please enter a confirmation number.")
                $(".searchError").show()
                return;
            }

            // Show loader
            $(".loader-screen").show();

            // Submit the form using AJAX
            $.ajax({
                url: '@Url.Action("SearchReservation", "Home")', // Replace with your controller name
                type: "POST",
                data: { ConfirmationNo: confirmationNumber },
                success: function (response) {
                    if (response.result) {
                        if (response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                        } else {
                            $(".loader-screen").hide();
                            $(".searchError").text("Reservation not found.");
                            $(".searchError").show();
                        }
                    }
                    else {
                        //alert("Reservation not found.");
                        $(".loader-screen").hide();
                        $(".searchError").text(response.errorMessage)
                        $(".searchError").show()
                    }

                },
                error: function () {
                    // Hide loader
                    $(".loader-screen").hide();
                    $(".searchError").text("An error occurred while searching for the reservation.")
                    $(".searchError").show()
                }
            });
         }

</script>