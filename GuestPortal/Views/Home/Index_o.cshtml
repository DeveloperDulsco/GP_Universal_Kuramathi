<link href="~/assets/css/additionalStyles.css" rel="stylesheet" />

<style>
    /* ── intl-tel-input overrides to match Bootstrap form-control ── */
    .iti {
        width: 100%;
        display: block;
        position: relative;
        z-index: 1;
    }

    .iti__flag-container {
        z-index: 1;
    }

    .phone-number-input.form-control {
        /*padding-left: 90px !important;*/
        border-radius: 4px !important;
        height: calc(1.5em + .75rem + 2px);
    }

    .iti__country-list {
        z-index: 5000;
        max-height: 220px;
        overflow-y: auto;
        font-size: 13px;
    }

    .iti__country.iti__highlight {
        background-color: #f0f0f0;
    }


    .phone-input-wrapper {
        width: 100%;
    }



    .phone-number-input {
        width: 100%;
        padding-left: 95px !important;
    }

    .iti__selected-flag {
        background: transparent !important;
    }
    /* Dial code color black instead of teal */
    .iti__selected-dial-code {
        color: #000 !important;
        font-weight: 500;
    }

    .iti--separate-dial-code .iti__selected-flag {
        padding-left: 12px;
        padding-right: 12px;
    }
    /*********************88*/
    /* Make intl-tel-input match your rounded textbox style */


    /* Match textbox height + radius */
    .iti input.form-control {
        height: calc(1.5em + .75rem + 2px);
        border-radius: 25px !important;
        padding-left: 85px !important;
    }

    /* Rounded left side (flag container) */
    .iti--separate-dial-code .iti__selected-flag {
        border-radius: 25px 0 0 25px !important;
        background: transparent !important;
        padding-left: 10px !important;
        padding-right: 6px !important;
        min-width: 70px !important;
    }





    /* Ensure validation border wraps correctly */
    .iti input.is-invalid {
        border-radius: 25px !important;
    }

    /* Align dropdown arrow better */
    .iti__arrow {
        margin-left: 4px !important;
    }

    @@media (max-width: 767px) {
        .phone-input-wrapper .iti,
        .phone-input-wrapper .iti__flag-container,
        .phone-input-wrapper .iti__selected-flag {
            z-index: 1 !important;
        }
    }
</style>

<div class="offset-md-0 col-md-3 offset-lg-0 col-lg-3  offset-xl-1 col-xl-2 left-menu h100">
    <div class="space"></div>
    <div class="menu">
        <div class="logo"> <img class="img-fluid" src="~/assets/images/logo.png"></div>
        @{ int PageNo = 1;}
        <ul>
            <li class="active @(ViewBag.PaymentProcessed ? "paymentdone active " : "") tabs"><a href="#guestDetails"><label>Guest Details</label><span class="count">@PageNo</span></a></li>
            @*@{ PageNo++;}
                <li class="@(ViewBag.PaymentProcessed ? "paymentdone active" : "") tabs"><a href="#upgrade"><label>Upgrade</label><span class="count">@PageNo</span></a></li>*@
            @{ PageNo++;}
            <li class="@(ViewBag.PaymentProcessed ? "paymentdone active" : "") tabs"><a href="#policies"><label>Policies</label><span class="count">@PageNo</span></a></li>
            @*@{ PageNo++;}
                @if (!Model.IsDepositAvailable)
                    {
                        <li class="@((ViewBag.PaymentProcessed && ViewBag.IsPaymentSuccess) ? "paymentdone active" : "") tabs"><a href="#payment"><label>Payment</label><span class="count">@PageNo</span></a></li>
                    }*@
            @{ PageNo++;}
            <li class="@((ViewBag.PaymentProcessed && ViewBag.IsPaymentSuccess && ViewBag.uploadcomplete) ? "paymentdone active" : "") tabs"><a href="#document"><label>Document</label><span class="count">@PageNo</span></a></li>
            @{ PageNo++;}
            <li class="@((ViewBag.IsPaymentSuccess && ViewBag.uploadcomplete) ? "paymentdone active" : "") tabs"><a href="#qrCode"><label>Thank You</label><span class="count">@PageNo</span></a></li>

        </ul>
    </div>
</div>


