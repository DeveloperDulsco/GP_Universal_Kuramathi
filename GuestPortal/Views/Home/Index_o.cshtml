        $(document).ready(function () {
           
            phoneInputEl = document.querySelector("#phoneNumber");

            if (phoneInputEl) {

                iti = window.intlTelInput(phoneInputEl, {

                    utilsScript: "/assets/js/intlTelInput/js/utils.js",

                    separateDialCode: true,

                    initialCountry: "in",

                    allowDropdown: true,

