        function SaveReservationAndMoveNext(btn) {

            const phoneInput = document.querySelector("#phoneNumber");

            // Step 1: Inject full international number for validation
            if (window.iti) {

                //phoneInput.value = iti.getNumber(); // example: +971562752598
                let fullNumber = iti.getNumber(); // +971562752598

                let dialCode = iti.getSelectedCountryData().dialCode;

                // keep only national number in textbox
                phoneInput.value = fullNumber.replace("+" + dialCode, "");
            }

            var form = $('#frm_guestdetails');

            // Step 2: Validate form
            if (!form.valid()) {

                console.log("Form invalid");

                return false;

            }
            phoneInput.value = iti.getNumber();
            // Step 3: Remove "+" only AFTER validation passes
            phoneInput.value = phoneInput.value.replace('+', '');

            // Step 4: Remove spaces if any
            phoneInput.value = phoneInput.value.replace(/\s/g, '');

            // Step 5: Submit form
            $('.loader-screen').fadeIn(100);

            const data = new URLSearchParams(
                new FormData(document.getElementById('frm_guestdetails'))
            );

            fetch(BaseURL + '/Home/UpdateReservation', {

                method: "POST",
                body: data

            })
                .then(response => response.json())
                .then(response => {

                    moveToNextTab(btn);

                    $('.loader-screen').fadeOut(1000);

                });

        }

                    function SavePolicies(btn) {

                        const data = new FormData();
                        var terms = $('#IsTermsAndConditionAccepted').is(':checked')

                        var Addterms = $('#IsAdditionalTermsAndConditionAccepted').is(':checked')


                        if (Addterms && terms) {
                            data.append('ReservationNumber', '@Model.ReservationNumber')
                            data.append('ReservationNameID','@Model.ReservationNameID')
                            data.append('IsTermsAndConditionAccepted', terms);
                            data.append('ReservationID', $('#ReservationID').val());
                            data.append('CheckBox1', terms);
                            //data.append('CheckBox2', receviceUpdate);
                            //data.append('CheckBox3', govtNote);

                            data.append('DepositAvailable', '@Model.IsDepositAvailable');
                            data.append('UploadComplete', '@Model.IsUploadComplete');
                            if (signaturePad.isEmpty()) {
                                $('#customMessageModalMessage').html("Please provide a signature first.");
                                $('#customMessageModal').modal('show');


                                return false;
                            } else {
                                var dataURL = signaturePad.toDataURL();
                                var strImage = dataURL.replace(/^data:image\/[a-z]+;base64,/, "");
                                data.append('Base64Signature', strImage);
                            }

                            $('.loader-screen').fadeIn(100);
                            fetch(BaseURL + '/Home/UpdatePolicies', {
                                method: "POST",
                                body: data,
                            }).then(response => response = response.json()).then(response => {
                                moveToNextTab(btn);
                                $('.loader-screen').fadeOut(1000);
                            });
                        }
                        else {
                            if (!terms) {
                                $('#customMessageModalMessage').html("Please accept terms and conditions.");
                                $('#customMessageModal').modal('show');
                            }
                            else {
                                $('#customMessageModalMessage').html("Please accept additional terms and conditions.");
                                $('#customMessageModal').modal('show');
                            }
                        }
                    }

