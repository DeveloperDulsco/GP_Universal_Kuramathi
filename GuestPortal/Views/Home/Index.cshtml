                        if (hasAllergiesVal === 'true') {
                            var allergens = ($('#Allergies').val() || '').trim();
                            var otherNotes = ($('#OtherAllergies').val() || '').trim();
                            if (!allergens && !otherNotes) {
                                $('#customMessageModalMessage').html("Please complete the allergen form (select allergens and/or enter Other/Notes), then Save.");
                                $('#customMessageModal').modal('show');
                                $('#allergenFormModal').modal('show');
                                return false;
                            }
                        }
                       
                        if (!excursionOk) {
                            $('#customMessageModalMessage').html("Please accept the Aqua Sports / Excursion Disclaimer.");
                            $('#customMessageModal').modal('show');
                            return false;
                        }
                        // Prefer committed modal-OK payload (with pad base64), else live pads + cache
                        var excursionPartsPayload = (typeof resolveExcursionParticipantsPayload === 'function')
                            ? resolveExcursionParticipantsPayload()
                            : null;
                        if (!excursionPartsPayload || !excursionPartsPayload.participants || excursionPartsPayload.participants.length < 1) {
                            $('#customMessageModalMessage').html("Please add at least one Aqua Sports participant with name and signature (open the disclaimer).");
                            $('#customMessageModal').modal('show');
                            $('#excursionDisclaimerModal').modal('show');
                            return false;
                        }
                        if (excursionPartsPayload.participants.length > MAX_EXCURSION_PARTS) {
                            $('#customMessageModalMessage').html("Aqua Sports participants cannot exceed reservation pax (" + MAX_EXCURSION_PARTS + ").");
                            $('#customMessageModal').modal('show');
                            $('#excursionDisclaimerModal').modal('show');
                            return false;
                        }
                        for (var epi = 0; epi < excursionPartsPayload.participants.length; epi++) {
                            var ep = excursionPartsPayload.participants[epi];
                            if (!ep.name || !ep.signature) {
                                $('#customMessageModalMessage').html("Each participant needs a name and signature.");
                                $('#customMessageModal').modal('show');
                                $('#excursionDisclaimerModal').modal('show');
                                return false;
                            }
                            if (!isValidExcursionPartName(ep.name)) {
                                $('#customMessageModalMessage').html("Participant names may only contain letters, spaces, hyphens, and apostrophes (max 80 characters).");
                                $('#customMessageModal').modal('show');
                                $('#excursionDisclaimerModal').modal('show');
                                return false;
                            }
                            delete ep.guardianSignature;
                        }
                        if (!terms) {
                            $('#customMessageModalMessage').html("Please accept terms and conditions.");
                            $('#customMessageModal').modal('show');
                            return false;
                        }
                        committedExcursionParticipants = JSON.parse(JSON.stringify(excursionPartsPayload));
                        $('#ExcursionParticipants').val(JSON.stringify(committedExcursionParticipants));

                        if (terms) {
                            data.append('ReservationNumber', '@Model.ReservationNumber')
                            data.append('ReservationNameID','@Model.ReservationNameID')
                            data.append('IsTermsAndConditionAccepted', terms);
                            data.append('ReservationID', $('#ReservationID').val());
                            data.append('CheckBox1', terms ? 'true' : 'false');
                            data.append('CheckBox2', $('#promotionalConsent').is(':checked') ? 'true' : 'false');
                            data.append('CheckBox3', excursionOk ? 'true' : 'false');
                            data.append('HasAllergies', hasAllergiesVal);
                            data.append('Allergies', $('#Allergies').val() || '');
                            data.append('OtherAllergies', $('#OtherAllergies').val() || '');
                            data.append('ExcursionAccepted', excursionOk ? 'true' : 'false');
                            data.append('ProfileID', '@(Model.Profiles != null && Model.Profiles.Count > 0 ? Model.Profiles[0].ProfileID : 0)');

                            data.append('DepositAvailable', '@Model.IsDepositAvailable');
                            data.append('UploadComplete', '@Model.IsUploadComplete');
                            if (signaturePad.isEmpty()) {
                                $('#customMessageModalMessage').html("Please provide a signature.");
                                $('#customMessageModal').modal('show');


                                return false;
                            } else {
                                var dataURL = signaturePad.toDataURL();
                                var strImage = dataURL.replace(/^data:image\/[a-z]+;base64,/, "");
                                data.append('Base64Signature', strImage);
                                // Each participant's own pad base64 (do not copy main pad)
                                data.append('ExcursionParticipants', $('#ExcursionParticipants').val() || '');
                            }

                            if (typeof gpGuardPortalSave === 'function' && !gpGuardPortalSave()) {
                                return false;
                            }
                            $('.loader-screen').fadeIn(100);
                            fetch(BaseURL + '/Home/UpdatePolicies', {
                                method: "POST",
                                body: data,
                            }).then(response => response = response.json()).then(response => {
                                moveToNextTab(btn);
                                $('.loader-screen').fadeOut(1000);
                            }).catch(function () {
                                if (typeof gpShowPortalTimeout === 'function') {
                                    gpShowPortalTimeout();
                                } else {
                                    $('.loader-screen').fadeOut(200);
                                }
                            });
                        }
                    }

                    // Allergen Yes/No + form modal
                    var allergenFormCommitted = false;
                    var ALLERGEN_OTHER_MAX = 50;

                    function updateAllergenOtherCount() {
                        var $notes = $('#allergenOtherNotes');
                        var val = ($notes.val() || '');
                        if (val.length > ALLERGEN_OTHER_MAX) {
                            val = val.substring(0, ALLERGEN_OTHER_MAX);
                            $notes.val(val);
                        }
                        $('#allergenOtherNotesCount').text(val.length + ' / ' + ALLERGEN_OTHER_MAX);
                    }

                    function restoreAllergenFormFromSaved() {
                        var saved = ($('#Allergies').val() || '').split(',').map(function (s) { return $.trim(s); }).filter(Boolean);
                        $('.allergen-item').each(function () {
                            $(this).prop('checked', saved.indexOf($(this).val()) >= 0);
                        });
                        var other = ($('#OtherAllergies').val() || '');
                        if (other.length > ALLERGEN_OTHER_MAX) {
                            other = other.substring(0, ALLERGEN_OTHER_MAX);
                            $('#OtherAllergies').val(other);
                        }
                        $('#allergenOtherNotes').val(other);
                        updateAllergenOtherCount();
                    }

                    function clearAllergenFormState() {
                        $('input[name="HasAllergies"]').prop('checked', false);
                        $('#Allergies').val('');
                        $('#OtherAllergies').val('');
                        $('.allergen-item').prop('checked', false);
                        $('#allergenOtherNotes').val('');
                        updateAllergenOtherCount();
                        $('#allergenSummaryText').text('');
                        $('#allergenSummary').hide();
                    }

                    function showAllergenSummary(summary) {
                        $('#allergenSummaryText').text('Allergens: ' + summary);
                        $('#allergenSummary').css('display', 'flex');
                    }

                    $('input[name="HasAllergies"]').on('change', function () {
                        var val = $(this).val();
                        if (val === 'true') {
                            allergenFormCommitted = false;
                            $('#allergenFormModal').modal('show');
                        } else {
                            allergenFormCommitted = true;
                            $('#Allergies').val('');
                            $('#OtherAllergies').val('');
                            $('.allergen-item').prop('checked', false);
                            $('#allergenOtherNotes').val('');
                            updateAllergenOtherCount();
                            $('#allergenSummaryText').text('');
                            $('#allergenSummary').hide();
                            $('#allergenFormModal').modal('hide');
                        }
                    });

                    // Bottom CANCEL (and legacy close btn if re-enabled): discard without save
                    $('#allergenFormCancelBtn, #allergenFormCloseBtn').on('click', function () {
                        $('#allergenFormModal').modal('hide');
                        if (!allergenFormCommitted) {
                            clearAllergenFormState();
                        } else {
                            restoreAllergenFormFromSaved();
                        }
                    });

                    $('#allergenEditBtn').on('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        $('#allergenFormModal').modal('show');
                    });

                    $('#allergenOtherNotes').on('input paste keyup', function () {
                        updateAllergenOtherCount();
                    });
                    $('#allergenFormModal').on('shown.bs.modal', function () {
                        restoreAllergenFormFromSaved();
                        updateAllergenOtherCount();
                    });

                    $('#allergenFormSaveBtn').on('click', function () {
                        var selected = [];
                        $('.allergen-item:checked').each(function () { selected.push($(this).val()); });
                        var other = ($('#allergenOtherNotes').val() || '').trim();
                        if (other.length > ALLERGEN_OTHER_MAX) {
                            other = other.substring(0, ALLERGEN_OTHER_MAX);
                            $('#allergenOtherNotes').val(other);
                            updateAllergenOtherCount();
                        }
                        if (selected.length === 0 && !other) {
                            $('#customMessageModalMessage').html("Select at least one allergen or enter Other/Notes.");
                            $('#customMessageModal').modal('show');
                            return;
                        }
                        $('#Allergies').val(selected.join(','));
                        $('#OtherAllergies').val(other);
                        allergenFormCommitted = true;
                        var summary = selected.join(', ');
                        if (other) { summary += (summary ? '; ' : '') + 'Other: ' + other; }
                        showAllergenSummary(summary);
                        $('#allergenFormModal').modal('hide');
                    });

                    // Aqua Sports participants — name + one signature pad each (no guardian pads in UI)
                    // MAX_EXCURSION_PARTS / caches declared above SavePolicies
                    $('#excursionPartMaxLabel').text(MAX_EXCURSION_PARTS);

                    function stripDataUrl(dataUrl) {
                        if (!dataUrl) return '';
                        return String(dataUrl).replace(/^data:image\/[a-zA-Z+]+;base64,/, '');
                    }

                    function readPadSignature(idx) {
                        var pad = excursionPartPads[idx];
                        if (pad && !pad.isEmpty()) {
                            try {
                                var sig = stripDataUrl(pad.toDataURL('image/png'));
                                if (sig) {
                                    excursionPartSigCache[idx] = sig;
                                    return sig;
                                }
                            } catch (e) { }
                        }
                        return excursionPartSigCache[idx] || '';
                    }

                    function resizeExcursionCanvas(canvas) {
                        if (!canvas) return;
                        var ratio = Math.max(window.devicePixelRatio || 1, 1);
                        var rect = canvas.getBoundingClientRect();
                        var w = Math.max(rect.width || canvas.clientWidth || 280, 200);
                        var h = Math.max(rect.height || canvas.clientHeight || 90, 70);
                        canvas.width = w * ratio;
                        canvas.height = h * ratio;
                        canvas.getContext('2d').scale(ratio, ratio);
                    }

                    function resizeAndPreservePad(idx) {
                        var pad = excursionPartPads[idx];
                        if (!pad || !pad.canvas) return;
                        var data = null;
                        if (!pad.isEmpty()) {
                            try { data = pad.toDataURL(); } catch (e) { data = null; }
                        }
                        if (!data && excursionPartSigCache[idx]) {
                            data = 'data:image/png;base64,' + excursionPartSigCache[idx];
                        }
                        var canvas = pad.canvas;
                        resizeExcursionCanvas(canvas);
                        excursionPartPads[idx] = new SignaturePad(canvas, {
                            backgroundColor: 'rgb(255,255,255)',
                            onEnd: function () { readPadSignature(idx); }
                        });
                        if (data) {
                            try {
                                excursionPartPads[idx].fromDataURL(data);
                                excursionPartSigCache[idx] = stripDataUrl(data);
                            } catch (e) { }
                        }
                    }

                    function sanitizeExcursionPartName(raw) {
                        return String(raw || '')
                            .replace(/[^A-Za-z\s'\-]/g, '')
                            .replace(/\s{2,}/g, ' ')
                            .substring(0, 80);
                    }

                    function isValidExcursionPartName(name) {
                        return /^[A-Za-z]+(?:[ '\-][A-Za-z]+)*$/.test(String(name || '').trim());
                    }

                    function buildExcursionParticipantRow(idx) {
                        return ''
                            + '<div class="excursion-part-row" data-idx="' + idx + '" style="border:1px solid #ccc;border-radius:8px;padding:10px;margin-bottom:10px;background:#fafafa;">'
                            + '  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">'
                            + '    <strong style="text-transform:none;">Participant ' + (idx + 1) + '</strong>'
                            + '    <button type="button" class="btnstyle remove-excursion-part" data-idx="' + idx + '" style="min-width:70px;padding:4px 8px;font-size:11px;background:#888;">Remove</button>'
                            + '  </div>'
                            + '  <label style="text-transform:none;font-weight:500;display:block;margin-bottom:4px;">Name</label>'
                            + '  <input type="text" class="form-control excursion-part-name" data-idx="' + idx + '" maxlength="80" autocomplete="off" placeholder="Participant full name" style="margin-bottom:8px;" />'
                            + '  <label style="text-transform:none;font-weight:500;display:block;">Signature</label>'
                            + '  <div class="excursion-sig-pad">'
                            + '    <div class="excursion-sig-pad-body">'
                            + '      <canvas class="excursion-part-sig" data-idx="' + idx + '"></canvas>'
                            + '    </div>'
                            + '  </div>'
                            + '  <button type="button" class="btnstyle blue clear-excursion-sig" data-idx="' + idx + '" style="min-width:90px;padding:6px 14px;font-size:12px;margin-top:8px;">CLEAR</button>'
                            + '</div>';
                    }

                    function initExcursionPad(idx) {
                        var sigCanvas = document.querySelector('canvas.excursion-part-sig[data-idx="' + idx + '"]');
                        if (!sigCanvas || typeof SignaturePad === 'undefined') return;
                        resizeExcursionCanvas(sigCanvas);
                        excursionPartPads[idx] = new SignaturePad(sigCanvas, {
                            backgroundColor: 'rgb(255,255,255)',
                            onEnd: function () { readPadSignature(idx); }
                        });
                    }

                    function addExcursionParticipant() {
                        if (excursionPartCount >= MAX_EXCURSION_PARTS) return;
                        var idx = excursionPartCount;
                        $('#excursionParticipantsList').append(buildExcursionParticipantRow(idx));
                        initExcursionPad(idx);
                        excursionPartCount++;
                        $('#addExcursionParticipantBtn').toggle(excursionPartCount < MAX_EXCURSION_PARTS);
                        $('.remove-excursion-part').toggle(excursionPartCount > 1);
                    }

                    function collectExcursionParticipants() {
                        var list = [];
                        $('#excursionParticipantsList .excursion-part-row').each(function () {
                            var idx = parseInt($(this).attr('data-idx'), 10);
                            var name = sanitizeExcursionPartName($(this).find('.excursion-part-name').val()).trim();
                            $(this).find('.excursion-part-name').val(name);
                            var sig = readPadSignature(idx);
                            if (name || sig) {
                                list.push({ name: name, signature: sig });
                            }
                        });
                        return { participants: list };
                    }

                    function payloadHasCompleteSignatures(payload) {
                        return !!(payload && payload.participants && payload.participants.length > 0
                            && payload.participants.length <= MAX_EXCURSION_PARTS
                            && payload.participants.every(function (p) { return p && p.name && p.signature; }));
                    }

                    function resolveExcursionParticipantsPayload() {
                        var live = collectExcursionParticipants();
                        if (payloadHasCompleteSignatures(live)) return live;
                        if (payloadHasCompleteSignatures(committedExcursionParticipants)) {
                            return JSON.parse(JSON.stringify(committedExcursionParticipants));
                        }
                        var hidden = ($('#ExcursionParticipants').val() || '').trim();
                        if (hidden) {
                            try {
                                var parsed = JSON.parse(hidden);
                                if (payloadHasCompleteSignatures(parsed)) return parsed;
                            } catch (e) { }
                        }
                        return live;
                    }

                    function ensureExcursionParticipantsUi() {
                        if ($('#excursionParticipantsList .excursion-part-row').length === 0) {
                            excursionPartCount = 0;
                            excursionPartPads = {};
                            excursionPartSigCache = {};
                            addExcursionParticipant();
                        }
                    }

                    function applySigToPad(idx, signature) {
                        if (!signature || !excursionPartPads[idx]) return;
                        try {
                            var raw = stripDataUrl(signature);
                            if (raw) excursionPartSigCache[idx] = raw;
                            var dataUrl = String(signature).indexOf('data:') === 0
                                ? signature
                                : ('data:image/png;base64,' + signature);
                            excursionPartPads[idx].fromDataURL(dataUrl);
                        } catch (e) { }
                    }

                    function rebuildExcursionParticipantsUi(savedParticipants) {
                        $('#excursionParticipantsList').empty();
                        excursionPartPads = {};
                        excursionPartSigCache = {};
                        excursionPartCount = 0;
                        var saved = savedParticipants || [];
                        if (saved.length === 0) {
                            addExcursionParticipant();
                            return;
                        }
                        for (var i = 0; i < saved.length && i < MAX_EXCURSION_PARTS; i++) {
                            addExcursionParticipant();
                            $('.excursion-part-name[data-idx="' + i + '"]').val(sanitizeExcursionPartName(saved[i].name || ''));
                            applySigToPad(i, saved[i].signature);
                        }
                        $('#addExcursionParticipantBtn').toggle(excursionPartCount < MAX_EXCURSION_PARTS);
                        $('.remove-excursion-part').toggle(excursionPartCount > 1);
                    }

                    $('#addExcursionParticipantBtn').on('click', function () {
                        var prevCount = excursionPartCount;
                        addExcursionParticipant();
                        if (excursionPartCount <= prevCount) return;
                        var $row = $('#excursionParticipantsList .excursion-part-row').last();
                        var $modalBody = $('#excursionDisclaimerModal .modal-body');
                        if (!$row.length || !$modalBody.length) return;
                        // Scroll modal body so the newly added participant section is in view
                        var targetTop = $modalBody.scrollTop() + ($row.offset().top - $modalBody.offset().top) - 12;
                        $modalBody.animate({ scrollTop: Math.max(0, targetTop) }, 'slow');
                    });

                    $(document).on('click', '.remove-excursion-part', function () {
                        if ($('#excursionParticipantsList .excursion-part-row').length <= 1) return;
                        var idx = parseInt($(this).attr('data-idx'), 10);
                        var saved = [];
                        $('#excursionParticipantsList .excursion-part-row').each(function () {
                            if (parseInt($(this).attr('data-idx'), 10) === idx) return;
                            var rowIdx = parseInt($(this).attr('data-idx'), 10);
                            var name = sanitizeExcursionPartName($(this).find('.excursion-part-name').val()).trim();
                            var sig = readPadSignature(rowIdx);
                            if (name || sig) saved.push({ name: name, signature: sig });
                        });
                        rebuildExcursionParticipantsUi(saved.filter(function (p) { return p.name; }));
                    });

                    $(document).on('click', '.clear-excursion-sig', function () {
                        var idx = parseInt($(this).attr('data-idx'), 10);
                        if (excursionPartPads[idx]) excursionPartPads[idx].clear();
                        delete excursionPartSigCache[idx];
                    });

                    $(document).on('keypress', '.excursion-part-name', function (e) {
                        var ch = String.fromCharCode(e.which || e.keyCode);
                        if (!/[A-Za-z\s'\-]/.test(ch)) {
                            e.preventDefault();
                        }
                    });

                    $(document).on('input paste', '.excursion-part-name', function () {
                        var $el = $(this);
                        var cleaned = sanitizeExcursionPartName($el.val());
                        if ($el.val() !== cleaned) {
                            var start = this.selectionStart;
                            $el.val(cleaned);
                            if (typeof start === 'number') {
                                this.setSelectionRange(Math.min(start, cleaned.length), Math.min(start, cleaned.length));
                            }
                        }
                    });

                    function openExcursionModal() {
                        ensureExcursionParticipantsUi();
                        $('#excursionDisclaimerModal').modal('show');
                    }

                    $('#openExcursionDisclaimer').on('click', function (e) {
                        e.preventDefault();
                        openExcursionModal();
                    });

                    $('#excursionDisclaimer').on('click', function (e) {
                        if (!$(this).is(':checked')) return;
                        e.preventDefault();
                        $(this).prop('checked', false);
                        openExcursionModal();
                    });

                    $('#excursionDisclaimerModal').on('shown.bs.modal', function () {
                        Object.keys(excursionPartPads).forEach(function (k) {
                            resizeAndPreservePad(k);
                        });
                    });

                    // Snapshot pad strokes before modal hide can zero canvas layout
                    $('#excursionDisclaimerModal').on('hide.bs.modal', function () {
                        Object.keys(excursionPartPads).forEach(function (k) {
                            readPadSignature(k);
                        });
                    });

                    $('#excursionDisclaimerOkBtn').on('click', function () {
                        var payload = collectExcursionParticipants();
                        if (!payload.participants.length) {
                            $('#customMessageModalMessage').html("Add at least one participant with name and signature.");
                            $('#customMessageModal').modal('show');
                            return;
                        }
                        if (payload.participants.length > MAX_EXCURSION_PARTS) {
                            $('#customMessageModalMessage').html("Participants cannot exceed reservation pax (" + MAX_EXCURSION_PARTS + ").");
                            $('#customMessageModal').modal('show');
                            return;
                        }
                        for (var i = 0; i < payload.participants.length; i++) {
                            if (!payload.participants[i].name || !payload.participants[i].signature) {
                                $('#customMessageModalMessage').html("Each participant needs a name and signature.");
                                $('#customMessageModal').modal('show');
                                return;
                            }
                            if (!isValidExcursionPartName(payload.participants[i].name)) {
                                $('#customMessageModalMessage').html("Participant names may only contain letters, spaces, hyphens, and apostrophes (max 80 characters).");
                                $('#customMessageModal').modal('show');
                                return;
                            }
                        }
                        committedExcursionParticipants = JSON.parse(JSON.stringify(payload));
                        $('#ExcursionParticipants').val(JSON.stringify(payload));
                        $('#excursionDisclaimer').prop('checked', true);
                        $('#excursionDisclaimerModal').modal('hide');
                    });

                    $('.confirmDeclaration').on('click', function (e) {
                        e.preventDefault();
                        var btn = $(this);

                        if ($('#frmDeclaration').valid()) {

                            const data = new URLSearchParams();
                            for (const pair of new FormData(document.getElementById('frmDeclaration'))) {
                                data.append(pair[0], pair[1]);
                            }
                            data.append('ReservationID', $('#ReservationID').val());
                            $('.loader-screen').fadeIn(100);
                            fetch(BaseURL + '/Home/SaveDeclaration', {
                                method: "POST",
                                body: data,
                            }).then(response => response = response.json()).then(response => {
                                moveToNextTab(btn);
                                $('.loader-screen').fadeOut(1000);
                            });
                        }

                    });

                    function LoadStateByCountry(countryID) {
                        var state = $('select.state');
                        var previousState = state.val();

                        if (!countryID) {
                            $(state).find('option').remove().end();
                            state.append("<option value=''>Select State</option>");
                            state.val('');
                            state.selectpicker('refresh');
                            return;
                        }

                        $.ajax({
                            url: BaseURL + "/api/PortalService/GetStateByCountryID/",
                            data: {
                                "CountryID": countryID
                            },
                            type: "GET",
                            dataType: "json",
                            success: function (data) {
                                $(state).find('option').remove().end();
                                state.append("<option value=''>Select State</option>");

                                var sortedStates = (data || []).slice().sort(function (a, b) {
                                    return (a.Statename || '').localeCompare(b.Statename || '', undefined, { sensitivity: 'base' });
                                });

                                $(sortedStates).each(function (i, obj) {
                                    $(state).append("<option value='" + obj.StateMasterID + "'>" + obj.Statename + "</option>");
                                });

                                if (previousState && state.find("option[value='" + previousState + "']").length) {
                                    state.val(previousState);
                                } else {
                                    state.val('');
                                }

                                state.selectpicker('refresh');
                            },
                            error: function (data) {
                                console.error(data);
                            }
                        });
                    }

                    function pageLoad() {

                        if ($('#MembershipNo').val() != '') {
                            $('#IsMembershipRequested').attr('disabled', true);
                            $('#MembershipNo').attr('readonly', true);
                        }
                        else {
                            $('#IsMembershipRequested').attr('disabled', false);
                            $('#MembershipNo').attr('readonly', false);
                        }

                        if ($('#IsMembershipRequested').is(':checked')) {
                            $('#MembershipNo').attr('readonly', true);
                        }

                    }

                    pageLoad();

    </script>

    <script>

                    $('.tick').each(function () {
                        // $(this).hide();
                    })
    // Track only document numbers that were successfully saved via UploadDocument.
    var uploadedDocs = [];
    // Doc number from the current modal OCR attempt (not yet saved). Cleared on Cancel.
    var pendingModalDocNumber = '';
    // Bumped on Cancel / new modal open so late OCR responses are ignored.
    var documentUploadOcrGeneration = 0;
    var DOCUMENT_MAX_BYTES = 2 * 1024 * 1024; // 2MB — aligned with UI copy
    var DOCUMENT_ACCEPT_MSG = 'Only passport (any country) or Maldives national ID is accepted. Please upload a valid document.';

    function logDocumentAction(eventName) {
        try {
            $.ajax({
                url: "@Url.Action("InsertEvent", "Home")",
                method: "POST",
                data: {
                    EventName: eventName,
                    reservationid: $("#ReservationID").val()
                },
                dataType: "json"
            });
        } catch (e) { }
    }

    function currentPrecheckinPageId() {
        var $active = $('.tab-pane.active').first();
        return $active.length ? $active.attr('id') : 'guestDetails';
    }

    function logPortalAudit(actionName, extraDetail, currentPage) {
        try {
            var payload = new URLSearchParams();
            payload.append('ActionName', actionName);
            payload.append('ExtraDetail', extraDetail || '');
