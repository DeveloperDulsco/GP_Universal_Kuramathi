        function restorePhoneDisplay() {

            if (!iti || !phoneInputEl) return;

            var raw = phoneInputEl.value.replace(/\s/g, "").replace(/^\+/, "");

            if (!raw) return;

            var selectedCountryText =
                $("#Profiles_0__CountryID option:selected").text().trim();

