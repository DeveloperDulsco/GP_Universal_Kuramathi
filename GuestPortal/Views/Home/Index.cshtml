            var selectedLower = selectedCountryText.toLowerCase();

            var match = findIntlCountryByDropdownText(selectedCountryText);

            console.log("selectedCountryText:", selectedCountryText);
            console.log("match:", match);

            if (match) {

                // Set correct flag/country
                iti.setCountry(match.iso2);

                var dialCode = match.dialCode; // UAE = 971, India = 91

                // Remove country code from stored number
                if (raw.startsWith(dialCode)) {
                    raw = raw.substring(dialCode.length);
                }
            }

            // Show only national number
            phoneInputEl.value = raw;
