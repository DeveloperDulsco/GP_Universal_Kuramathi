                    function getGuestNameFromDocumentInfo() {
                        var fullName = (documentInformation.fullName || "").trim();
                        if (fullName) {
                            return fullName;
                        }

                        var nameParts = [
                            documentInformation.firstName,
                            documentInformation.middleName,
                            documentInformation.lastName
                        ].filter(function (value) {
                            return value && value.trim();
                        });

                        return nameParts.join(' ').trim();
                    }

                    function updateGuestNameFromDocumentInfo(guestID) {
                        var guestName = getGuestNameFromDocumentInfo();
                        if (!guestName) {
                            return;
