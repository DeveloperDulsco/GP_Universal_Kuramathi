            $guest.parent('li').removeClass('sucess');
            $('#guestskip_' + guestID).show();
        }

        function markGuestUploadCompleted(guestID) {
            var $guest = $('#guestid_' + guestID);
            $guest.parent('li').addClass('sucess').removeClass('skipped');
            $guest.data('upload', 'completed');
            $guest.html('<i class="fas fa-check-circle"></i> COMPLETE');
            $('#guestskip_' + guestID).hide();
        }

        function proceedDocumentUpload($trigger) {
            if (typeof gpGuardPortalSave === 'function' && !gpGuardPortalSave()) {
                return;
            }
            $('.loader-screen').fadeIn(100);
            waitForPendingDocumentUploads().then(function () {
                // Persist per-profile skips BEFORE Thank You / PreCheckinComplete so FO report updates on redirect.
                var skipPromise = (typeof hasAnySkippedDocument === 'function' && hasAnySkippedDocument())
                    ? persistGuestDocumentSkips(true)
                    : $.Deferred().resolve({ result: true }).promise();

                return $.when(skipPromise).always(function () {
                    $.ajax({
                        url: "@Url.Action("CompletedocUploadAsync", "Home")",
                        method: "POST",
                        type: "POST",
                        dataType: "json",
                        data: {
                            ReservationNumber: @Model.ReservationNumber,
                            ReservationNameID: @Model.ReservationNameID,
                        },
                        success: function (data) {
                            documentupload = true;
                            $('.loader-screen').fadeOut(500);
                            moveToNextTab($trigger);
                        },
                        error: function (xhr, status) {
                            if (status === 'timeout' || (typeof gpPortalIdleExpired === 'function' && gpPortalIdleExpired())) {
                                if (typeof gpShowPortalTimeout === 'function') {
                                    gpShowPortalTimeout();
                                } else {
                                    $('.loader-screen').fadeOut(500);
                                }
                                return;
                            }
                            documentupload = true;
                            $('.loader-screen').fadeOut(500);
                            moveToNextTab($trigger);
                        },
                        timeout: (window.GP_PORTAL_REQUEST_MS || 60000)
                    });
                });
            });
        }

        function isDocumentUploadComplete() {
            var isComplete = true;
            $('.fileUpload,.fileUpload1,.fileUpload2').each(function () {
                if (!isUploadMarkedRequired($(this))) {
                    return;
                }
                var uploadStatus = $(this).data('upload');
                // completed or skipped (after failed attempt) satisfies the slot
                if (uploadStatus === 'incomplete' || uploadStatus === 'uploading') {
                    isComplete = false;
                }
            });

            $('.scanDocument').each(function () {
                if (!isUploadMarkedRequired($(this))) {
                    return;
                }
                if ($(this).data('scan') === 'incomplete') {
                    isComplete = false;
                }
            });

            return isComplete;
        }

