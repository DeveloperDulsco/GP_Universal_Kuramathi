        function findIntlCountryByDropdownText(selectedCountryText) {

            if (!selectedCountryText) return null;

            var countryList = window.intlTelInputGlobals.getCountryData();

            var selected = selectedCountryText
                .toLowerCase()
                .replace(/\(.*?\)/g, "")
                .trim();

            // 1. Exact normalized match only
            var exactMatch = countryList.find(function (c) {
                var name = c.name
                    .toLowerCase()
                    .replace(/\(.*?\)/g, "")
                    .trim();

                return name === selected;
            });

            if (exactMatch) return exactMatch;

            // 2. Manual fallback for common country names from your DB
            var manualMap = {
                "india": "in",
                "united arab emirates": "ae",
                "uae": "ae",
                "singapore": "sg",
                "united states": "us",
                "usa": "us",
                "united kingdom": "gb",
                "uk": "gb"
            };

            if (manualMap[selected]) {
                return countryList.find(function (c) {
                    return c.iso2 === manualMap[selected];
                });
            }

            return null;
        }

