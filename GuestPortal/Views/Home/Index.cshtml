                var $el = $(this);
                var name = ($el.attr('name') || '').toString();
                if (!name || $el.attr('type') === 'hidden') return;
                if (name.indexOf('ProfileDetailID') >= 0 || name.indexOf('ProfileID') >= 0) return;
                parts.push(name + '=' + ($el.val() || ''));
            });
            gpGuestDetailsSnapshot = parts.join('|');
        } catch (e) {
            gpGuestDetailsSnapshot = '';
        }
    }

    function collectGuestDetailChanges() {
        var changed = [];
        try {
            $('#frm_guestdetails').find('input, select, textarea').each(function () {
                var $el = $(this);
                var name = ($el.attr('name') || '').toString();
                if (!name || $el.attr('type') === 'hidden') return;
                if (name.indexOf('ProfileDetailID') >= 0 || name.indexOf('ProfileID') >= 0) return;
                var token = name + '=' + ($el.val() || '');
                if (gpGuestDetailsSnapshot && gpGuestDetailsSnapshot.indexOf(token) < 0) {
                    changed.push(name);
                }
            });
        } catch (e) { }
