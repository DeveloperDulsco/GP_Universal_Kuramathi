@model CheckinPortal.Models.ReservationModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Pre-check-in only: ReservationModel + _Layout. Do not use _LayoutCheckout / CheckoutReservationModel.
    var ProfileList = (List<CheckinPortal.Models.Profile>)Model.Profiles;
    var primaryProfile = ProfileList[0];

    /*var PackageList = (List<CheckinPortal.Models.PackageMasterModal>)ViewBag.PackageList;*/
    var PackageList = ViewBag.PackageList as List<CheckinPortal.Models.PackageMasterModal>
                  ?? new List<CheckinPortal.Models.PackageMasterModal>();
    var PackageListForRoomUpsell = PackageList.Where(x => x.IsRoomUpsell).ToList();
    var PackageListForSpecials = PackageList.Where(x => x.IsRoomUpsell == false).ToList();

    string RoomUpsellPackages = ViewBag.RoomUpsellPackages;
    string SpecialPackages = ViewBag.SpecialPackages;

    int resumeTabIndex = -1;
    if (ViewBag.ResumeTabIndex != null)
    {
        int.TryParse(ViewBag.ResumeTabIndex.ToString(), out resumeTabIndex);
    }
    bool useResumeTab = ViewBag.PaymentProcessed != true && resumeTabIndex >= 0;
}
<script>
    @*window.BlinkIDLicenseKey = '@System.Configuration.ConfigurationManager.AppSettings["BlinkIDLicenseKey"]';*@
       var APIbaseURL = '@System.Configuration.ConfigurationManager.AppSettings["APIBaseUrl"]';
</script>
<script>

        var OCRAPIBaseURL = "@ViewBag.OCRAPIBaseURL";
        var AdaptorAPIBaseURL = "@ViewBag.AdaptorAPIBaseURL";
        ReservationNumber = "@Model.ReservationNumber"
        ReservationNameID = "@Model.ReservationNameID"
        var IsDepositAvailable = "@Model.IsDepositAvailable";
        var IsPaymentDisabled = true; // Phase 1 — payment in phase 2; keep precheckin unblocked
        @if (ViewBag.IsPaymentDisabled != null)
        {
            <text>IsPaymentDisabled = @(ViewBag.IsPaymentDisabled == true ? "true" : "false");</text>
        }
        else
        {
            <text>IsPaymentDisabled = @(string.Equals(System.Configuration.ConfigurationManager.AppSettings["IsPaymentDisabled"], "true", StringComparison.OrdinalIgnoreCase) ? "true" : "false");</text>
        }
        var TotalRoomRate = "@Model.TotalRoomRate";
        var TotalSpecialCharges = 0;
        var selectedUpsellPackage = [];
        var selectedSpecialPackage = [];
    var isuploadcomplete = "@ViewBag.uploadcomplete";
     var language = "@(Request.Cookies.AllKeys.Contains("culture") ? @Request.Cookies["culture"].Value : "en")";
        var ServerCompletedTabIndex = @(ViewBag.CompletedTabIndex != null ? ViewBag.CompletedTabIndex.ToString() : "-1");
        var ServerResumeTabIndex = @resumeTabIndex;
        var SkipPrecheckinSplash = @(ViewBag.SkipPrecheckinSplash == true ? "true" : "false");

        selectedUpsellPackage = "@RoomUpsellPackages".split(",")
        selectedSpecialPackage = "@SpecialPackages".split(",")


        selectedUpsellPackage = selectedUpsellPackage.filter(function (value, index, arr) {
            return value != "";
        });

        selectedSpecialPackage = selectedSpecialPackage.filter(function (value, index, arr) {
            return value != "";
        });



</script>

<style>
    .adyen-checkout__button__text {
        width: 100% !important;
    }

    .fade-alert {
        opacity: 0;
        display: none;
        transition: opacity 0.5s ease-in-out;
    }

        .fade-alert.show {
            display: block;
            opacity: 1;
