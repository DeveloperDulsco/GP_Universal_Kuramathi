@section Scripts{
    <script src="~/assets/js/multilang.js"></script>
    @* Phase 1: payment disabled — do not load Adyen (GetOrginKey) or the page can hang *@
    @if (ViewBag.IsPaymentDisabled != true
         && !string.Equals(System.Configuration.ConfigurationManager.AppSettings["IsPaymentDisabled"], "true", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/assets/js/adyenFunctions.js"></script>
    }
    <script>
        // Document upload uses httpPost; adyenFunctions.js is skipped when payment is disabled.
        if (typeof httpPost !== 'function') {
            window.httpPost = function (endpoint, data) {
                return fetch(endpoint, {
                    method: 'POST',
                    body: JSON.stringify(data),
                    headers: {
                        Accept: 'application/json, text/plain, */*',
                        'Content-Type': 'application/json'
                    }
                }).then(function (response) { return response.json(); });
            };
        }
