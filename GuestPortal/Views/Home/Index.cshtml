                // Maldives national ID: nationality is MDV/MV even when OCR MRZ nationality is blank.
                if (isAcceptedGuestDocument(documentInformation.documentType, documentInformation.issueCountry, documentInformation.documentNumber)
                    && isMaldivesIssueCountry(documentInformation.issueCountry)
                    && isNationalIdDocumentType(documentInformation.documentType)) {
                    documentInformation.nationality = 'MV';
                    return;
                }
                var bookingNationality = getSelectedNationalityCode();
                if (bookingNationality) {
                    documentInformation.nationality = bookingNationality;
                }
            }
        }

        function isMaldivesIssueCountry(issueCountry) {
            var country = (issueCountry || '').toString().trim().toUpperCase();
            return country === 'MDV' || country === 'MV' || country === 'MALDIVES'
                || country.indexOf('MALDIV') >= 0;
        }

        function hydratePrimaryGuestDetailsFromUpload(response) {
            try {
                var primaryProfileDetailId = '@(Model.Profiles != null && Model.Profiles.Count > 0 ? Model.Profiles[0].ProfileDetailID : 0)';
                var uploadedProfileDetailId = (response.profileDetailID != null && response.profileDetailID !== undefined)
                    ? String(response.profileDetailID)
                    : ($('#currentProfileID').val() || '').toString();
                if (!response || !response.result || String(uploadedProfileDetailId) !== String(primaryProfileDetailId)) {
                    return;
                }

                if (response.nationality) {
                    var $nat = $('select.selectNationality');
                    if ($nat.length) {
                        $nat.selectpicker('val', response.nationality);
                        if (!$nat.val()) {
                            $nat.val(response.nationality);
                        }
                        $nat.selectpicker('refresh');
                        $('#selectedNationality').val($nat.val() || response.nationality);
                    }
                }

                if (response.addressLine1) {
                    $('#Profiles_0__AddressLine1').val(response.addressLine1);
                }
                if (response.city) {
                    $('#Profiles_0__City').val(response.city);
                }
                if (response.postalCode) {
                    $('#Profiles_0__PostalCode').val(response.postalCode);
                }
                if (response.countryId) {
                    var $country = $('select.selectCountry');
                    if ($country.length) {
                        $country.selectpicker('val', String(response.countryId));
                        $country.trigger('change');
                        $country.selectpicker('refresh');
                    }
                }
            } catch (e) { }
        }

