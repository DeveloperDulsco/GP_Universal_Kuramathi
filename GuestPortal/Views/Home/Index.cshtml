        function processDocumentNew(files, target) {
            var fileControl = $(target);

            var fileName = $(fileControl).val().split("\\").pop();
            var imgPreview = $(fileControl).parent('div').find('img');
            var filextension = fileName.split(".");
            var documentReadStatus = $(fileControl).parent('div').find(".alert");
            var filecontrolID = $(fileControl).attr("id");
            var alertId = documentReadStatus.attr("id");
            if (filecontrolID == "primaryDoc1") {
                setPrimaryDoc2Enabled(false);
            }
            $(documentReadStatus).hide();

            if ($('.docUploadFile').index(fileControl) == 0) {
                resetDocumentInfo();

                $('#primaryDoc2').val('');
                $('#primaryDoc2').siblings(".custom-file-label").removeClass("selected").html('Choose file');
                $('#primaryDoc2').parent('div').find('img').attr('src', '');
                $('#primaryDoc2').parent('div').find('img').hide();
                if (filecontrolID == "primaryDoc1") {
                    setPrimaryDoc2Enabled(false);
                }
                var primaryDoc2alert = $('#primaryDoc2').parent('div').find(".alert")
                $(primaryDoc2alert).hide();
            }


            var filext = "." + filextension.slice(-1)[0];
            var valid = [".jpg", ".png", ".jpeg"];

            if (valid.indexOf(filext.toLowerCase()) == -1) {
                hideDocumentLoader();
                showAlert(alertId, "File type not supported. Please upload a JPG or PNG image (max 2MB).", "warning");
                logDocumentAction('DocumentUploadInvalidFile');
                $(fileControl).val('');
                $(fileControl).siblings(".custom-file-label").removeClass("selected").html('Choose file');
                $(fileControl).parent('div').find('img').attr('src', '');
                $(fileControl).parent('div').find('img').hide();
                return;
            }

            {
                $('.loader-screen').fadeIn(100);
                logDocumentAction('DocumentUploadAttempt');
                var ocrGeneration = documentUploadOcrGeneration;
                    // Compress first (mobile camera captures are often >2MB raw), then enforce max size on result.
                    compress.compress(files, {
                        size: 2,
                        quality: 0.75,
                        maxWidth: 1920,
                        maxHeight: 1920,
                        resize: true
                    }).then((images) => {
                        if (ocrGeneration !== documentUploadOcrGeneration) {
                            return;
                        }
                        const imgout = images[0]
                        var compressedBytes = (typeof imgout.endSizeInMb === 'number')
                            ? (imgout.endSizeInMb * 1024 * 1024)
                            : (imgout.data ? (imgout.data.length * 0.75) : 0);
                        if (compressedBytes > DOCUMENT_MAX_BYTES) {
                            hideDocumentLoader();
                            showAlert(alertId, "File is too large. Maximum size is 2MB.", "warning");
                            logDocumentAction('DocumentUploadOversized');
                            $(fileControl).val('');
                            $(fileControl).siblings(".custom-file-label").removeClass("selected").html('Choose file');
                            $(fileControl).parent('div').find('img').attr('src', '');
                            $(fileControl).parent('div').find('img').hide();
                            if (filecontrolID === "primaryDoc1") {
                                setPrimaryDoc2Enabled(false);
                            }
                            return;
                        }
                        var imageBase64 = imgout.data;
                        var ocrPayload = {
                            imageBase64: imageBase64,
                            extension: ".jpg"
                        };
                        if (filecontrolID === "primaryDoc2") {
                            var frontSrc = $('#imgprimaryDoc1').attr('src') || '';
                            var frontB64 = (frontSrc || '').replace(/^data:image\/[a-zA-Z0-9+.-]+;base64,/, '');
                            if (!frontB64) {
                                hideDocumentLoader();
                                showAlert(alertId, "Please upload the Front of your national ID first.", "warning");
                                $(fileControl).val('');
                                $(fileControl).siblings(".custom-file-label").removeClass("selected").html('Choose file');
                                $(fileControl).parent('div').find('img').attr('src', '');
                                $(fileControl).parent('div').find('img').hide();
                                return;
                            }
                            ocrPayload.imageBase64 = frontB64;
                            ocrPayload.imageBase64Back = imageBase64;
                        }
                        validateDocumentDirect(ocrPayload).then(function (response) {
                            if (filecontrolID !== "primaryDoc2" || !frontIsNationalIdForBack() || !(response && response.Result)) {
                                return response;
                            }
                            if (isIncompatibleIdBackType(
                                response.responseData && response.responseData.idType,
                                response.responseData && (response.responseData.issueCountry || response.responseData.issueCountry_fullname),
                                response.responseData && response.responseData.documentNumber)) {
                                var combinedMismatch = new Error('wrong-back');
                                combinedMismatch.gpWrongBack = true;
                                throw combinedMismatch;
                            }
                            // Combined OCR may still report the front ID type; classify the back image alone.
                            return validateDocumentDirect({
                                imageBase64: imageBase64,
                                extension: ".jpg"
                            }).then(function (backOnly) {
                                var backType = backOnly && backOnly.responseData && backOnly.responseData.idType;
                                var backCountry = backOnly && backOnly.responseData
                                    && (backOnly.responseData.issueCountry || backOnly.responseData.issueCountry_fullname);
                                var backNumber = backOnly && backOnly.responseData && backOnly.responseData.documentNumber;
                                if (isIncompatibleIdBackType(backType, backCountry, backNumber)) {
                                    var backMismatch = new Error('wrong-back');
                                    backMismatch.gpWrongBack = true;
                                    throw backMismatch;
                                }
                                return response;
                            });
                        }).then(response => {
                            if (ocrGeneration !== documentUploadOcrGeneration) {
                                return;
                            }
                            console.log(response);
                            if (response.Result) {
                                assignDocumentInfo(response, filecontrolID === "primaryDoc2");

                                var transactionIDRequestObj = {
                                    "RequestObject": response.responseData.TransactionID
                                };
                                const isValid =
                                    filecontrolID === "primaryDoc2" ||
                                    (
                                        filecontrolID === "primaryDoc1" &&
                                        response.responseData?.idType != null &&
                                        response.responseData.idType !== ""
                                    );
                                console.log('isValid : ' + isValid);
                                if (isValid) {
                                   var skipExpiryUntilBack = false;
                                   if (filecontrolID === "primaryDoc1") {
                                       skipExpiryUntilBack = shouldEnableBackSide(
                                           response.responseData.idType,
                                           response.responseData.issueCountry || response.responseData.issueCountry_fullname,
                                           response.responseData.documentNumber)
                                           && !response.responseData.expiryDate;
                                   }
                                   if (!response.responseData.IsExpired || skipExpiryUntilBack) {
                                        if (filecontrolID === "primaryDoc1"
                                            && !isAcceptedGuestDocument(
                                                response.responseData.idType,
                                                response.responseData.issueCountry || response.responseData.issueCountry_fullname,
                                                response.responseData.documentNumber)) {
                                            rejectUnsupportedDocument(alertId, fileControl, filecontrolID, DOCUMENT_ACCEPT_MSG);
                                            return;
                                        }
                                        if (isDocumentNumberAlreadyUploaded(response.responseData.documentNumber)) {
                                            hideDocumentLoader();

                                            showAlert(alertId, "This document is already uploaded now for another guest.", "warning");

                                            $(fileControl).val('');
                                            $(fileControl).siblings(".custom-file-label").removeClass("selected").html('Choose file');
                                            $(fileControl).parent('div').find('img').attr('src', '');
                                            $(fileControl).parent('div').find('img').hide();
                                            if (filecontrolID === "primaryDoc1") {
                                                resetDocumentInfo();
                                                clearPendingModalDocNumber();
                                                setPrimaryDoc2Enabled(false);
                                            }
                                            return;
                                        }
                                        // Remember OCR number for this modal attempt only — do NOT mark as uploaded until DB save.
                                        if (filecontrolID === "primaryDoc1") {
                                            setPendingModalDocNumber(response.responseData.documentNumber);
                                        }
                                        if (filecontrolID === "primaryDoc2") {
                                            $(imgPreview).attr('src', `${imgout.prefix}${imgout.data}`);
                                            $(imgPreview).show();
                                        }
                                        else if (response.responseData && response.responseData.fullImage) {
                                            $(imgPreview).attr('src', "data:image/jpg;base64," + response.responseData.fullImage);
                                            $(imgPreview).show();
                                        }
                                        else {
                                            $(imgPreview).attr('src', `${imgout.prefix}${imgout.data}`);
                                            $(imgPreview).show();
                                        }

                                        if (filecontrolID === "primaryDoc1") {
                                            // Unlock Back for national ID / Maldives NIC; passport stays single-side.
                                            // Do not require a narrow OCR type match — prior fix failed when BlinkID
                                            // returned PASSPORT / odd types while the Front preview still showed.
                                            if (shouldEnableBackSide(
                                                response.responseData.idType,
                                                response.responseData.issueCountry || response.responseData.issueCountry_fullname,
                                                response.responseData.documentNumber)) {
                                                setPrimaryDoc2Enabled(true);
                                            }
                                            else {
                                                setPrimaryDoc2Enabled(false);
                                            }
                                        }
                                        console.log('isValid : ' + response.responseData.idType);
                                        clearDocumentUploadSkipOption();
                                        hideDocumentLoader();


                                    }
                                    else {
                                        hideDocumentLoader();
                                        showAlert(alertId, "Document is expired. Please upload a valid one", "warning");
                                        recordDocumentUploadFailure($("#currentGuestIndex").val());
                                        logDocumentAction('DocumentUploadExpiryFail');

                                        $(fileControl).val('');
                                        $(fileControl).siblings(".custom-file-label").removeClass("selected").html('Choose file');
                                        $(fileControl).parent('div').find('img').attr('src', '');
                                        $(fileControl).parent('div').find('img').hide();
                                        if (filecontrolID === "primaryDoc1") {
                                            setPrimaryDoc2Enabled(false);
                                        }
                                    }
                                }
                                else {
                                    hideDocumentLoader();

                                    showAlert(alertId, "Please upload a valid document", "warning");
                                    recordDocumentUploadFailure($("#currentGuestIndex").val());
                                    logDocumentAction('DocumentUploadInvalid');

                                    $(fileControl).val('');
                                    $(fileControl).siblings(".custom-file-label").removeClass("selected").html('Choose file');
                                    $(fileControl).parent('div').find('img').attr('src', '');
                                    $(fileControl).parent('div').find('img').hide();
                                    if (filecontrolID === "primaryDoc1") {
                                        setPrimaryDoc2Enabled(false);
                                    }

                                }

                            }
                            else {
                                hideDocumentLoader();
                                var failMsg = (response && response.ResponseMessage) ? response.ResponseMessage : "Please upload a valid document";
                                if (failMsg && /microblink|unable to read|null|unavailable|timeout/i.test(failMsg)) {
                                    logDocumentAction('MicroblinkUnavailable');
                                }
                                showAlert(alertId, "Please upload a valid document", "warning");
                                recordDocumentUploadFailure($("#currentGuestIndex").val());
                                logDocumentAction('DocumentUploadInvalid');

                                $(fileControl).val('');
                                $(fileControl).siblings(".custom-file-label").removeClass("selected").html('Choose file');
                                $(fileControl).parent('div').find('img').attr('src', '');
                                $(fileControl).parent('div').find('img').hide();
                                if (filecontrolID === "primaryDoc1") {
                                    setPrimaryDoc2Enabled(false);
                                }
                            }

                        }).catch(function (err) {
                            if (err && err.gpWrongBack) {
                                rejectMismatchedBackDocument(alertId, fileControl);
                                return;
                            }
                            hideDocumentLoader();
                            logDocumentAction('MicroblinkUnavailable');
                            showAlert(alertId, "Document service is temporarily unavailable. Please try again.", "warning");
                            recordDocumentUploadFailure($("#currentGuestIndex").val());
                            $(fileControl).val('');
                            $(fileControl).siblings(".custom-file-label").removeClass("selected").html('Choose file');
                            $(fileControl).parent('div').find('img').attr('src', '');
                            $(fileControl).parent('div').find('img').hide();
                            if (filecontrolID === "primaryDoc1") {
                                setPrimaryDoc2Enabled(false);
                            }
                        });


                    }).catch(function () {
                        hideDocumentLoader();
                        logDocumentAction('DocumentUploadCompressFail');
                        showAlert(alertId, "Unable to process this image. Please try a smaller JPG or PNG (max 2MB).", "warning");
                        $(fileControl).val('');
                        $(fileControl).siblings(".custom-file-label").removeClass("selected").html('Choose file');
                        $(fileControl).parent('div').find('img').attr('src', '');
                        $(fileControl).parent('div').find('img').hide();
                        if (filecontrolID === "primaryDoc1") {
                            setPrimaryDoc2Enabled(false);
                        }
                    });

                $(fileControl).siblings(".custom-file-label").addClass("selected").html(fileName);
            }
        }

