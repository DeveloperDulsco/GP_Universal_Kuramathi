                            <div class="tab-pane  cstm-form @((ViewBag.PaymentProcessed && ViewBag.IsPaymentSuccess && !ViewBag.uploadcomplete) || (useResumeTab && resumeTabIndex == 2) ? "active" : "")  " id="document">
                                <h1>Upload document</h1>
                                <div class="content">
                                    <p>Dear @Model.Profiles[0].Salutation @Model.Profiles[0].FirstName @Model.Profiles[0].MiddleName @Model.Profiles[0].LastName,</p>
                                    <p>In this final step for identity verification, please upload one valid document per guest (passport from any country, or Maldives national ID only).</p>
                                    <p id="documentUploadIntro">Only one valid document is required per guest. Accepted: passport (any country) or Maldives national ID. Document upload is mandatory for every guest in the reservation.</p>
                                    <div id="documentUploadSkipHelp" class="alert alert-warning" style="display:none;" role="alert">
                                        If you experience any issues uploading your ID, you can skip. Kindly present your ID at the front office so staff can upload it manually.
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="user-list">
                                                <ul>
                                                    @{
                                                        var totalGuestSlots = Model.AdultCount + Model.ChildCount + Model.InfantCount;
                                                        if (totalGuestSlots < 1)
                                                        {
                                                            totalGuestSlots = 1;
                                                        }
                                                    }
                                                    @for (int i = 0; i < totalGuestSlots; i++)
                                                    {
                                                        string guestRoleLabel;
                                                        if (i < Model.AdultCount)
                                                        {
                                                            guestRoleLabel = i == 0 ? "Main Guest" : ("Adult " + (i + 1));
                                                        }
                                                        else if (i < Model.AdultCount + Model.ChildCount)
                                                        {
                                                            guestRoleLabel = "Child " + (i - Model.AdultCount + 1);
                                                        }
                                                        else
                                                        {
                                                            guestRoleLabel = "Infant " + (i - Model.AdultCount - Model.ChildCount + 1);
                                                        }

                                                        string GuestName = guestRoleLabel;
                                                        int GuestID = 0;
                                                        int PMSProfileID = 0;
                                                        bool hasDocumentUploaded = false;
                                                        bool isDocumentSkipped = false;
                                                        if (Model.Profiles != null && Model.Profiles.Count > i)
                                                        {
                                                            var profileName = $"{Model.Profiles[i].FirstName} {Model.Profiles[i].MiddleName} {Model.Profiles[i].LastName}".Trim();
                                                            if (!string.IsNullOrWhiteSpace(profileName))
                                                            {
                                                                GuestName = profileName;
                                                            }

                                                            GuestID = Model.Profiles[i].ProfileDetailID;
                                                            PMSProfileID = Model.Profiles[i].ProfileID;
                                                            // COMPLETE only when an image was actually saved (not DocumentNumber-only from PMS).
                                                            hasDocumentUploaded = Model.Profiles[i].HasDocumentUploaded
                                                                || Model.Profiles[i].DocumentImage1 == "0";
                                                            isDocumentSkipped = Model.Profiles[i].IsDocumentSkipped && !hasDocumentUploaded;
                                                        }

                                                        bool isRequiredUpload = true;
                                                        string uploadStatus = hasDocumentUploaded ? "completed" : (isDocumentSkipped ? "skipped" : "incomplete");
                                                        string liClass = hasDocumentUploaded ? "sucess" : (isDocumentSkipped ? "skipped" : "");
                                                        string uploadLabel = hasDocumentUploaded
                                                            ? "<i class=\"fas fa-check-circle\"></i> COMPLETE"
                                                            : (isDocumentSkipped
                                                                ? "<i class=\"fas fa-forward\"></i> SKIPPED"
                                                                : "<i class=\"fas fa-cloud-upload-alt\"></i> UPLOAD");

                                                        <li class="@liClass">
                                                            <label id="guestname_@(i + 1)" data-default-name="@GuestName">@GuestName<br /><small class="text-muted">(@guestRoleLabel)</small></label>
                                                            <div class="pic"><img src="~/assets/images/avatar.png"></div>
                                                            <a href="#" id="guestid_@(i + 1)" class="fileUpload" data-guestpmsprofileid="@PMSProfileID" data-guestprofileid="@GuestID" data-upload="@uploadStatus" data-guestid="@(i + 1)" data-required="true" data-guest-role="@guestRoleLabel">
                                                                @Html.Raw(uploadLabel)
                                                            </a>
                                                            <a href="#" id="guestskip_@(i + 1)" class="guestDocumentSkip btnstyle" data-guestid="@(i + 1)" style="display:none; margin-left:8px; text-transform:uppercase;">
                                                                <i class="fas fa-forward"></i> SKIP
                                                            </a>
                                                            @*<a href="#" id="scan_guestid_@(i + 1)" class="scanDocument" data-guestpmsprofileid="@PMSProfileID"  data-guestprofileid="@GuestID" data-scan="incomplete" data-guestid="@(i + 1)"><i class="fas fa-camera"></i> SCAN DOCUMENT</a>*@
                                                        </li>

                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-6 col-xl-4 offset-xl-8 offset-lg-6">
                                        <div class="btn-grp d-flex justify-content-between">
                                            @*<button class="btn_cancel" value='Back' style="display:@((ViewBag.PaymentProcessed && ViewBag.IsPaymentSuccess)  ? "none" : "block") ">Back</button>*@
                                            <button class="btn_next checkUpload">Next <img src="~/assets/images/arrow_icon.png"></button>
