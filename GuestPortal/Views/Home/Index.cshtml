<style>
    /* ── intl-tel-input overrides to match Bootstrap form-control ── */
    .iti {
        width: 100%;
        display: block;
        z-index: 1 !important;
    }

    .iti__flag-container {
        z-index: 1 !important;
    }

    .phone-number-input.form-control {
        /*padding-left: 90px !important;*/
        /*border-radius: 4px !important;*/
        height: calc(1.5em + .75rem + 2px);
    }

    .iti__country-list {
        z-index: 9999;
        max-height: 220px;
        overflow-y: auto;
        font-size: 13px;
    }

    .iti__country.iti__highlight {
        background-color: #f0f0f0;
    }


    .phone-input-wrapper {
        width: 100%;
    }



/*    .phone-number-input {
        height: calc(2.5em + .75rem + 2px) !important;
        width: 100%;
        padding-left: 95px !important;
    }*/

    .iti__selected-flag {
        background: transparent !important;
    }
    /* Dial code color black instead of teal */
    .iti__selected-dial-code {
        color: #000 !important;
        font-weight: 500;
    }

    .iti--separate-dial-code .iti__selected-flag {
        padding-left: 12px;
        padding-right: 12px;
    }
    /*********************88*/
    /* Make intl-tel-input match your rounded textbox style */


    /* Match textbox height + radius */
    .iti input.form-control {
        height: calc(1.5em + .75rem + 2px);
        border-radius: 25px !important;
        padding-left: 85px !important;
    }

    /* Rounded left side (flag container) */
    .iti--separate-dial-code .iti__selected-flag {
        border-radius: 25px 0 0 25px !important;
        background: transparent !important;
        padding-left: 10px !important;
        padding-right: 6px !important;
        min-width: 70px !important;
    }





    /* Ensure validation border wraps correctly */
    .iti input.is-invalid {
        border-radius: 25px !important;
    }

    /* Align dropdown arrow better */
    .iti__arrow {
        margin-left: 4px !important;
    }
</style>

