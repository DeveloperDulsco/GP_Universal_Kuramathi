    function isMaldivesIssueCountry(issueCountry) {
        var country = (issueCountry || '').toString().trim().toUpperCase();
        return country === 'MDV' || country === 'MV' || country === 'MALDIVES'
            || country.indexOf('MALDIV') >= 0;
    }

    function isAcceptedGuestDocument(idType, issueCountry, documentNumber) {
        var type = (idType || '').toString().trim().toUpperCase().replace(/^TYPE_/, '');
        if (isPassportDocumentType(type)) {
            return true;
        }
        if (looksLikeMaldivesNationalIdNumber(documentNumber)) {
            return true;
        }
        if (!type) {
            return false;
        }
        return isNationalIdDocumentType(type) && isMaldivesIssueCountry(issueCountry);
    }

    function isPassportDocumentType(idType) {
        var type = (idType || '').toString().trim().toUpperCase().replace(/^TYPE_/, '');
        return type === 'PASSPORT' || type === 'P' || type === 'PP'
            || type.indexOf('PASSPORT') >= 0;
    }

    function isAadhaarDocumentType(idType) {
        var type = (idType || '').toString().trim().toUpperCase().replace(/^TYPE_/, '');
        var normalized = type.replace(/[-_\s]/g, '');
        return normalized.indexOf('AADHAAR') >= 0 || normalized.indexOf('AADHAR') >= 0
            || normalized.indexOf('UIDAI') >= 0
            || type.indexOf('ENROLLMENT') >= 0;
    }

    function isIncompatibleIdBackType(idType, issueCountry, documentNumber) {
        if (!idType) {
            return false;
        }
        if (isAadhaarDocumentType(idType) || isPassportDocumentType(idType)) {
            return true;
        }
        var type = (idType || '').toString().trim().toUpperCase();
        if (type.indexOf('DRIVER') >= 0 || type.indexOf('LICENCE') >= 0 || type.indexOf('LICENSE') >= 0
            || type.indexOf('VISA') >= 0 || type.indexOf('RESIDENCE') >= 0) {
            return true;
        }
        if (isNationalIdDocumentType(idType)) {
            var country = (issueCountry || '').toString().trim();
            if (country && !isMaldivesIssueCountry(country) && !looksLikeMaldivesNationalIdNumber(documentNumber)) {
                return true;
            }
            return false;
        }
        return true;
    }

    function frontIsNationalIdForBack() {
        return shouldEnableBackSide(
            documentInformation.documentType,
            documentInformation.issueCountry,
            documentInformation.documentNumber);
    }

    function isNationalIdDocumentType(idType) {
        var type = (idType || '').toString().trim().toUpperCase().replace(/^TYPE_/, '');
        if (!type || isPassportDocumentType(type) || isAadhaarDocumentType(type)) {
            return false;
        }
        // BlinkID kebab types (id, multipurpose-id, eid) + legacy IDENTITY_CARD / NID.
        var normalized = type.replace(/[-_\s]/g, '');
        return type === 'IDENTITY_CARD' || type === 'NID' || type === 'NATIONAL_ID'
            || type === 'ID_CARD' || type === 'ID' || type === 'EID'
            || type.indexOf('IDENTITY') >= 0
            || type.indexOf('CARD') >= 0
            || normalized === 'NATIONALID' || normalized.indexOf('NATIONALID') >= 0
            || /(^|[^A-Z])ID$/.test(type.replace(/[-_\s]/g, ' '));
    }

    function looksLikeMaldivesNationalIdNumber(docNumber) {
        var n = (docNumber || '').toString().trim().toUpperCase().replace(/\s/g, '');
        // Maldives NIC commonly A + digits (e.g. A117183).
        return /^A\d{6,}$/.test(n);
    }

    // Back only for accepted Maldives national ID. Passport is single-side. No other IDs.
    function shouldEnableBackSide(idType, issueCountry, documentNumber) {
        if (isPassportDocumentType(idType)) {
            return false;
        }
        if (!isAcceptedGuestDocument(idType, issueCountry, documentNumber)) {
            return false;
        }
        return isNationalIdDocumentType(idType) || looksLikeMaldivesNationalIdNumber(documentNumber);
    }

