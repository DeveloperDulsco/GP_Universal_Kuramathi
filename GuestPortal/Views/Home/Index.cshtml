    function normalizeUploadedDocNumber(docNum) {
        if (docNum == null || docNum === undefined) {
            return '';
        }
        return String(docNum).trim();
    }

    function isDocumentNumberAlreadyUploaded(docNum) {
        var normalized = normalizeUploadedDocNumber(docNum);
        if (!normalized) {
            return false;
        }
        var normalizedLower = normalized.toLowerCase();
        for (var i = 0; i < uploadedDocs.length; i++) {
            if (String(uploadedDocs[i]).toLowerCase() === normalizedLower) {
                return true;
            }
        }
        return false;
    }

    function trackUploadedDocumentNumber(docNum) {
        var normalized = normalizeUploadedDocNumber(docNum);
        if (!normalized) {
            return;
        }
        if (!isDocumentNumberAlreadyUploaded(normalized)) {
            uploadedDocs.push(normalized);
        }
    }

    function untrackUploadedDocumentNumber(docNum) {
        var normalized = normalizeUploadedDocNumber(docNum);
        if (!normalized) {
            return;
        }
        var normalizedLower = normalized.toLowerCase();
        uploadedDocs = uploadedDocs.filter(function (d) {
            return String(d).toLowerCase() !== normalizedLower;
        });
    }

    function setPendingModalDocNumber(docNum) {
        pendingModalDocNumber = normalizeUploadedDocNumber(docNum);
    }

    function clearPendingModalDocNumber() {
        pendingModalDocNumber = '';
    }

    // Drop provisional OCR / modal file state without touching saved uploadedDocs.
    function clearDocumentUploadModalState() {
        documentUploadOcrGeneration++;
        clearPendingModalDocNumber();
        try { resetDocumentInfo(); } catch (e) { }
        try { clearFileUpload(); } catch (e) { }
        try { hideDocumentLoader(); } catch (e) { }
    }

    // Cancel / close without save: drop provisional OCR state only.
    // Never remove numbers already confirmed via UploadDocument / page seed.
    function cancelDocumentUploadAttempt() {
        clearDocumentUploadModalState();
        logDocumentAction('DocumentUploadCancelled');
