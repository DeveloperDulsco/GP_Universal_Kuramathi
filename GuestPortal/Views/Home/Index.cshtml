        function updateDocumentUploadSkipVisibility() {
            if (isDocumentUploadComplete() && !hasAnySkippedDocument()) {
                clearDocumentUploadSkipOption();
            }
        }

        function recordDocumentUploadFailure(guestID) {
            documentUploadFailCount++;
            // Show Skip only after 2 failed upload attempts
            if (documentUploadFailCount >= DOCUMENT_UPLOAD_SKIP_AFTER_FAILS) {
                showDocumentUploadSkipOption();
                if (guestID) {
                    $('#guestskip_' + guestID).show();
                }
            }
        }

        function hasAnySkippedDocument() {
            var skipped = false;
            $('.fileUpload').each(function () {
                if ($(this).data('upload') === 'skipped') {
                    skipped = true;
                }
            });
            return skipped;
        }

        function markGuestDocumentSkipped(guestID) {
            var $guest = $('#guestid_' + guestID);
            $guest.data('upload', 'skipped');
            $guest.html('<i class="fas fa-forward"></i> SKIPPED');
            $guest.parent('li').removeClass('sucess').addClass('skipped');
            $('#guestskip_' + guestID).hide();
            showDocumentUploadSkipOption();
            persistGuestDocumentSkips(false);
        }

        function collectDocumentOutcome() {
            var uploaded = 0;
            var skippedNoProfile = [];
            var skippedSlots = [];
            var skippedIds = [];
            var skippedLabels = [];
            $('.fileUpload').each(function () {
                var status = ($(this).data('upload') || '').toString();
                var slot = parseInt($(this).data('guestid'), 10) || 0;
                var pid = parseInt($(this).data('guestprofileid'), 10) || 0;
                var role = ($(this).data('guest-role') || '').toString().trim() || ('Guest ' + slot);
                if (status === 'completed') {
                    uploaded++;
                    return;
                }
                if (status === 'skipped') {
                    skippedLabels.push(role);
                    skippedSlots.push(slot);
                    skippedIds.push(pid);
                    if (pid <= 0) {
                        skippedNoProfile.push(role);
                    }
                }
            });
            var pax = $('.fileUpload').length;
            return {
                pax: pax,
                uploaded: uploaded,
                skippedIds: skippedIds,
                skippedSlots: skippedSlots,
                skippedLabels: skippedLabels,
                skippedWithoutProfile: skippedNoProfile
            };
        }

        function persistGuestDocumentSkips(finalize) {
            var outcome = collectDocumentOutcome();
            if (!finalize && outcome.skippedIds.length === 0 && outcome.skippedWithoutProfile.length === 0) {
                return $.Deferred().resolve({ result: true }).promise();
            }
            return $.ajax({
                url: "@Url.Action("DocumentUploadSkipped", "Home")",
                method: "POST",
                data: {
                    ReservationID: $("#ReservationID").val(),
                    ReservationNameID: '@Model.ReservationNameID',
                    ReservationNumber: '@Model.ReservationNumber',
                    ProfileDetailIDs: outcome.skippedIds.join(','),
                    SkippedGuestLabels: outcome.skippedLabels.join(', '),
                    SkippedGuestIndexes: outcome.skippedSlots.join(','),
                    SkippedWithoutProfileLabels: outcome.skippedWithoutProfile.join(', '),
                    PaxCount: outcome.pax,
                    UploadedCount: outcome.uploaded,
                    SkippedWithoutProfileCount: outcome.skippedWithoutProfile.length,
                    FinalizeDocumentStep: finalize === true
                },
                type: "POST",
                dataType: "json"
            });
        }

        var pendingDocumentUploads = {};

        function hasPendingDocumentUploads() {
            return Object.keys(pendingDocumentUploads).length > 0;
        }

        function updateDocumentProceedButtonsState() {
            var isUploading = hasPendingDocumentUploads();
            $('.checkUpload').prop('disabled', isUploading);
            $('#btnDocumentSkipAndProceed').prop('disabled', isUploading);
        }

        function waitForPendingDocumentUploads() {
            return new Promise(function (resolve) {
                function check() {
                    if (!hasPendingDocumentUploads()) {
                        resolve();
                        return;
                    }
                    setTimeout(check, 300);
                }
                check();
            });
        }

        function markGuestUploadInProgress(guestID) {
            var $guest = $('#guestid_' + guestID);
