    @RenderSection("Scripts", false)

    <script>
        function sleep(milliseconds) {
            const date = Date.now();
            let currentDate = null;
            do {
                currentDate = Date.now();
            } while (currentDate - date < milliseconds);
        }

        var ReservationFound = "@ViewBag.ReservationFound";
        var PaymentProcessed = "@ViewBag.PaymentProcessed";
        var SkipPrecheckinSplashLayout = "@ViewBag.SkipPrecheckinSplash" === "True";
        var LayoutResumeTabIndex = parseInt("@(ViewBag.ResumeTabIndex != null ? ViewBag.ResumeTabIndex : -1)", 10);
        if (isNaN(LayoutResumeTabIndex)) {
            LayoutResumeTabIndex = -1;
        }

        $('.loader-screen').fadeIn(100);

        function beginRegistration(fromUserStart) {
            $('#divSplash').fadeOut(200);
            $('#mainDiv').fadeIn(800);
            guardPrecheckinHistory();
            // Do not seed tbReservationMetaData here — CompletedTabIndex is written on Next only.
        }

        // Keep browser Back from leaving mid-wizard / reloading Search (QR → Index)
        // and from bouncing Landing ↔ Thank You after completion.
        var gpHistoryGuarded = false;
        function guardPrecheckinHistory() {
            if (gpHistoryGuarded || !window.history || !history.pushState) {
                return;
            }
            gpHistoryGuarded = true;
            try {
                var completeLocked = (typeof isPrecheckinFullyComplete === 'function' && isPrecheckinFullyComplete());
                history.replaceState({ gpPrecheckin: 1, gpThankYouLocked: completeLocked ? 1 : 0 }, '', window.location.href);
                if (!completeLocked) {
                    history.pushState({ gpPrecheckin: 1 }, '', window.location.href);
                }
                window.addEventListener('popstate', function () {
                    if (typeof isPrecheckinFullyComplete === 'function' && isPrecheckinFullyComplete()) {
                        if (typeof lockPrecheckinToThankYou === 'function') {
                            lockPrecheckinToThankYou();
                        }
                        history.pushState({ gpPrecheckin: 1, gpThankYouLocked: 1 }, '', window.location.href);
                        return;
                    }
                    history.pushState({ gpPrecheckin: 1 }, '', window.location.href);
                });
            } catch (e) { }
        }

        window.onload = (event) => {
            setTimeout(function () {
                $('.loader-screen').fadeOut(500);
                if (ReservationFound == "True") {
                    if (PaymentProcessed == "True") {

                        if (IsredirectedfromPaymentPage == "True") {
                            if (IsPaymentSuccess == "True") {
                                $('#paymentStatusMessage').html("Your preauthorisation was successful.");
                            }
                            else {
                                $('#paymentStatusMessage').html(PaymentFailureMessage);
                            }
                            $('#paymentStatusModal').modal('show');
                        }

                        $('#divSplash').hide();
                        $('#mainDiv').fadeIn(800);
                        // Still restore wizard tab if progress exists (payment flow)
                        if (typeof resumePrecheckinProgress === 'function') {
                            resumePrecheckinProgress(false);
                        }
                        guardPrecheckinHistory();
                    }
                    else if (SkipPrecheckinSplashLayout || (typeof SkipPrecheckinSplash !== 'undefined' && SkipPrecheckinSplash)) {
                        // Server already resolved CompletedTabIndex — open wizard at saved step (no START flash).
                        $('#divSplash').hide();
                        $('#mainDiv').show();
                        var resumeIdx = (typeof ServerResumeTabIndex !== 'undefined' && ServerResumeTabIndex >= 0)
                            ? ServerResumeTabIndex
                            : LayoutResumeTabIndex;
                        if (typeof isPrecheckinFullyComplete === 'function' && isPrecheckinFullyComplete()) {
                            if (typeof lockPrecheckinToThankYou === 'function') {
                                lockPrecheckinToThankYou();
                            }
                        } else if (typeof resumePrecheckinFromServer === 'function') {
                            resumePrecheckinFromServer(resumeIdx);
                        } else if (typeof activatePrecheckinStep === 'function' && typeof getPrecheckinStepByIndex === 'function') {
                            activatePrecheckinStep(getPrecheckinStepByIndex(resumeIdx));
                        }
                        guardPrecheckinHistory();
                    }
                    else {
                        // Fresh visit: show START. Client resume remains a fallback if meta fetch lagged server-side.
                        $('#mainDiv').hide();
                        $('#divSplash').fadeIn(800);
                        if (typeof resumePrecheckinProgress === 'function') {
                            resumePrecheckinProgress(true);
                        }
                        guardPrecheckinHistory();
                    }
                }
                else {
                    $('#mainDiv').show();
                    $('#divSplash').hide(800);
                }
            }, 500);
        };


        $(document).ready(function () {


        });

    </script>

