@{
    Layout = null;
    string expiryMessage = ViewBag.ExpiryMessage as string;
    if (string.IsNullOrWhiteSpace(expiryMessage))
    {
        expiryMessage = CheckinPortal.Helpers.LinkExpiryHelper.DefaultMessage;
    }
    var asm = typeof(CheckinPortal.MvcApplication).Assembly;
    string appVersion = asm.GetName().Version != null ? asm.GetName().Version.ToString() : "1.0.0.0";
    var infoAttrs = asm.GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false);
    if (infoAttrs != null && infoAttrs.Length > 0)
    {
        var infoVer = ((System.Reflection.AssemblyInformationalVersionAttribute)infoAttrs[0]).InformationalVersion;
        if (!string.IsNullOrWhiteSpace(infoVer))
        {
            appVersion = infoVer;
        }
    }
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link href="~/assets/css/all.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/custom.css">
    <link rel="icon" type="image/png" href="~/assets/images/logo.png?v=@appVersion" sizes="32x32">
    <link rel="shortcut icon" type="image/png" href="~/assets/images/logo.png?v=@appVersion">
    <title>Link Expiry</title>
</head>
<body class="bg-hotel link-expiry-page">
    <div class="header-top">
        <img src="~/assets/images/logo.png" alt="Niva Kuramathi Maldives" />
    </div>
    <div class="container thank">
        <p style="white-space: pre-line;">@expiryMessage</p>
    </div>
    <footer class="search-reservation-footer link-expiry-footer">
        Powered by Dots · © 2026. All rights reserved. Version @appVersion
    </footer>
    <script src="~/assets/js/jquery-3.5.1.slim.min.js"></script>
    <script src="~/assets/js/bootstrap.bundle.js"></script>
    <script src="~/assets/js/app.js"></script>
</body>
</html>
