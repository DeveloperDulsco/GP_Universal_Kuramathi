                                        <div class="col-4" style="font-size: 22px;">
                                            <label>Balance Amount :</label>
                                            <span>SGD @Model.BalanecAmount</span>

                                        </div>
                                        <div class="col-4"></div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">

                                        </div>

                                        <div class="col-xl-4 col-md-4  payment">
