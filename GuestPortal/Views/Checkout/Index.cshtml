@model CheckinPortal.Models.CheckoutReservationModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutCheckout.cshtml";
    var ActiveTransctions = new List<CheckinPortal.Models.PaymentHeader>();
    if (ViewBag.ActiveTransactions != null)
    {
        ActiveTransctions = (List<CheckinPortal.Models.PaymentHeader>)ViewBag.ActiveTransactions;
    }
    // Agree only when folio balance is zero (payment disabled for this property — outstanding balance → contact FO)
    var canAgreeToFolio = Math.Abs(Model.BalanecAmount) <= 0.0001m;
    var isPaymentDisabled = ViewBag.IsPaymentDisabled == true
        || string.Equals(System.Configuration.ConfigurationManager.AppSettings["IsPaymentDisabled"], "true", StringComparison.OrdinalIgnoreCase);
}

<script>
    ReservationNumber = "@Model.ReservationNumber"
    ReservationNameID = "@Model.ReservationNameID"
    var Amount = "@Model.BalanecAmount"
       var language = "@(Request.Cookies.AllKeys.Contains("culture") ? @Request.Cookies["culture"].Value : "en")";
    var IsPaymentDisabled = @(isPaymentDisabled ? "true" : "false");

</script>

