@section Scripts{

    <script src="~/assets/js/multilang.js"></script>

    @* Payment disabled — do not load Adyen (GetOrginKey) or the page can error / hang *@
    @if (!isPaymentDisabled)
    {
        <script src="~/assets/js/adyenFunctionsCheckout.js"></script>
    }
    else
    {
        <script>
            if (typeof httpPost !== 'function') {
                window.httpPost = function (endpoint, data) {
                    return fetch(endpoint, {
                        method: 'POST',
                        body: JSON.stringify(data),
                        headers: {
                            Accept: 'application/json, text/plain, */*',
                            'Content-Type': 'application/json'
                        }
                    }).then(function (response) { return response.json(); });
                };
            }
        </script>
    }
    <script src="~/assets/js/signature_pad.umd.js"></script>
    <script src="~/assets/js/wizard.js"></script>

    @*<script src="~/assets/js/app.js"></script>*@

    <script>
        var selectedPSPReference;
        function selectCardForTransaction(transctionID) {

            $('#card_' + transctionID).prop('checked', true);
            selectedPSPReference = $('#card_' + transctionID).val();
        }

        const processExistingTransction = (cardData) => httpPost(BaseURL + '/Checkout/processExistingTransction', cardData).then(response => {
            return response;
        });

        const processCheckout = (cardData) => httpPost(BaseURL + '/Checkout/ProcessCheckout', cardData).then(response => {
            return response;
        });


        function showExistingPaymentPoup() {
            $('#cardSelectionModal').modal('show');
        }

        function processExistingTransaction() {

            var pspReference;
            var cardSelected = false;
            $('.selectedCard').each(function (e) {
                console.log(this);
                if ($(this).is(':checked')) {
                    pspReference = $(this).val();
                    cardSelected = true;
                }
            });

            if (cardSelected) {
                $('.loader-screen').fadeIn(100);

                processExistingTransction({
                    ReservationNo: ReservationNumber,
                    pspReferenceNo: pspReference,
                    Amount: Amount
                }).then(response => {
                    if (response.result) {
                        $('#messageContent').html('Your payment was successful.')
                        $('#cardSelectionModal').modal('hide');
                        $('#paymentStatusPopup').modal('show');
                        setTimeout(function () {
                            var obj = $('#paymentNextButton');
                            moveToNextTab(obj);
                            $('.loader-screen').fadeOut(800);
                        }, 1000);
                    }
                    else {
                        $('.loader-screen').fadeOut(800);
                        $('#messageContent').html('Payment process failed.');
                        $('#paymentStatusPopup').modal('show');
                        $('#cardSelectionModal').modal('hide');
                    }


                }).catch(error => {
                    //processe the error and show error message
                    $('.loader-screen').fadeOut(800);
                    $('#customMessageModalMessage').html('Unable to process payment')
                    $('#customMessageModal').modal('show');
                });
            }
            else {
                $('.loader-screen').fadeOut(800);
                $('#customMessageModalMessage').html('Please select card to proceed')
                $('#customMessageModal').modal('show');

            }



        }


        function ShowContactFrontDesk() {
            $('#contactFOModal').modal('show');
        }

        var wrapper = document.getElementById("signature-pad");
        var clearButton = wrapper.querySelector("[data-action=clear]");
        //var changeColorButton = wrapper.querySelector("[data-action=change-color]");
        //var undoButton = wrapper.querySelector("[data-action=undo]");
        //var savePNGButton = wrapper.querySelector("[data-action=save-png]");
        //var saveJPGButton = wrapper.querySelector("[data-action=save-jpg]");
        //var saveSVGButton = wrapper.querySelector("[data-action=save-svg]");
        var canvas = wrapper.querySelector("canvas");
        var signaturePad = new SignaturePad(canvas, {
            // It's Necessary to use an opaque color when saving image as JPEG;
            // this option can be omitted if only saving as PNG or SVG
            backgroundColor: 'rgb(255, 255, 255)'
        });

        clearButton.addEventListener("click", function (event) {
            signaturePad.clear();
        });


        $(window).on("load", function () {

            $("#myCheck").click(function () {

                if ($(this).is(":checked")) {
                    $("#signbox").show();
                } else {
                    $("#signbox").hide();
                }

                $('html, body').animate({
                    scrollTop: $(".justify-content-between").offset().top
                }, 1000);
            });
        });
    </script>

    <script>


        // Switch wizard panes: hide all, show target. Avoids folio+thankyou stacking when
        // next() is taken from #payment while #folio is still .active.
        function showCheckoutPane(paneSelector) {
            var $pane = $(paneSelector);
            if (!$pane.length) {
                return;
            }
            $('.tab-content > .tab-pane').removeClass('active');
            $pane.addClass('active');
            setActiveTab($('.tab-pane').index($pane));
            $("html, body").animate({ scrollTop: 0 }, "slow");
        }

        function moveToNextTab(currentTab) {
            var $parentDiv = $(currentTab).closest('div.tab-pane');
            var $nextTab = $parentDiv.nextAll('div.tab-pane').first();
            if ($nextTab.length > 0) {
                showCheckoutPane($nextTab);
            } else {
                $("html, body").animate({ scrollTop: 0 }, "slow");
            }
        }

        function movePrevTab(currentTab) {
            var $parentDiv = $(currentTab).closest('div.tab-pane');
            var $prevTab = $parentDiv.prevAll('div.tab-pane').first();
            if ($prevTab.length > 0) {
                showCheckoutPane($prevTab);
            } else {
                $("html, body").animate({ scrollTop: 0 }, "slow");
            }
        }


        $('.moveNext').on('click', function () {
            moveToNextTab(this);
        });


        $('.movePrev').on('click', function () {
            movePrevTab(this);
        });



        function saveSignature() {



        }


        function AgreeAndMoveNext(obj) {

            // Non-zero folio balance (debit or credit): block Agree — guest must contact Front Desk
            var balanceAmount = parseFloat(("@Model.BalanecAmount" || "0").toString().replace(',', '.')) || 0;
            if (Math.abs(balanceAmount) > 0.0001) {
                ShowContactFrontDesk();
                return;
            }

            if ($("#myCheck").is(':checked')) {

                if (!signaturePad.isEmpty()) {
                    const data = new FormData();
                    var terms = $("#myCheck").is(':checked')
                    data.append('IsTermsAndConditionAccepted', terms);
                    data.append('ReservationID', $('#ReservationID').val());
                    var dataURL = signaturePad.toDataURL();
                    var strImage = dataURL.replace(/^data:image\/[a-z]+;base64,/, "");
                    data.append('Base64Signature', strImage);

                    fetch(BaseURL + '/Checkout/UpdateSignature', {
                        method: "POST",
                        body: data,
                    }).then(response => response = response.json()).then(response => {
                        // Balance is zero — complete pre check-out (payment deferred to phase 2)
                        $('.loader-screen').fadeIn(100);
                        var formdata = new FormData();
                        formdata.append('ReservationID', $('#ReservationID').val());

                        fetch(BaseURL + '/Checkout/CompletePreCheckout', {
                            method: "POST",
                            body: formdata,
                        }).then(response => response = response.json()).then(response => {
                            if (response && response.contactFrontDesk) {
                                $('.loader-screen').fadeOut(500);
                                ShowContactFrontDesk();
                                return;
                            }
                            if (response && response.result === false) {
                                $('#customMessageModalMessage').html(response.message || "Unable to process your checkout.");
                                $('#customMessageModal').modal('show');
                                $('.loader-screen').fadeOut(500);
                                return;
                            }
                            setTimeout(function () {
                                // Always folio → Thank You on same page (never window.open / new tab).
                                // Clearing all panes first prevents folio+thankyou stacking when #payment exists in DOM.
                                showCheckoutPane('#thankyou');
                                $('.loader-screen').fadeOut(500);
                            }, 500);
                        }).catch(error => {
                            $('#customMessageModalMessage').html("Unable to process your checkout.");
                            $('#customMessageModal').modal('show');
                            $('.loader-screen').fadeOut(500);
                        });
                    });

                }
                else {
                    $('#messageContentFolio').html('Sign the folio invoice');
                    $('#exampleModal2').modal('show');

                }
            }
            else {
                $('#messageContentFolio').html('Please accept the terms and conditions');
                $('#exampleModal2').modal('show');
            }

        }


        function MakePaymentAndMoveNext(obj) {
            $('.loader-screen').fadeIn(100);
            var formdata = new FormData();
            formdata.append('ReservationID', $('#ReservationID').val());
            fetch(BaseURL + '/Checkout/CompletePreCheckout', {
                method: "POST",
                body: formdata,
            }).then(response => response = response.json()).then(response => {
                setTimeout(function () {
                    showCheckoutPane('#thankyou');
                     $('.loader-screen').fadeOut(800);
                }, 500);
            });

        }


        function setActiveTab(index) {
            $('.tabs').each(function (i, e) {
                $(this).removeClass('active');
                if (i <= index) {
                    $(this).addClass('active');
                }
            });
        }


        function sendEmail() {
            var email = $('#emailID').val();

            if (email) {
                var formdata = new FormData();
                formdata.append('email', email);
                formdata.append('reservationId', $('#ReservationID').val())
                fetch(BaseURL + '/api/portalservice/SendEmail', {
                    method: "POST",
                    body: formdata,
                }).then(response => response = response.json()).then(response => {
                    $('#messageContentFolio').html('We have sent your invoice to the email provided. You will receive it within 15 minutes.');
                    $('#exampleModal2').modal('show');
                });
            }
            else {
                $('#messageContentFolio').html('Please enter email address');
                $('#exampleModal2').modal('show');
            }
        }

        // Full multi-tab lock per reservation (BroadcastChannel + localStorage heartbeat)
        (function initCheckoutReservationTabLock() {
            var resNo = (typeof ReservationNumber !== 'undefined' ? ReservationNumber : '') || '@Model.ReservationNumber';
            if (!resNo) {
                return;
            }
            var lockKey = 'gp_checkout_tab_lock_' + resNo;
            var tabId = 'tab_' + Date.now() + '_' + Math.random().toString(36).slice(2);
            var HEARTBEAT_MS = 2500;
            var STALE_MS = 12000;
            var channel = null;
            var isOwner = false;
            var isBlocked = false;
            var heartbeatTimer = null;
            var watchTimer = null;
            var BLOCK_MSG = 'This reservation is already open in another tab. Please continue in that tab.';

            try {
                if (typeof BroadcastChannel !== 'undefined') {
                    channel = new BroadcastChannel(lockKey);
                }
            } catch (e) { }

            function now() {
                return Date.now();
            }

            function readLock() {
                try {
                    var raw = localStorage.getItem(lockKey);
                    if (!raw) {
                        return null;
                    }
                    if (raw.charAt(0) !== '{') {
                        return { tabId: raw, ts: 0 };
                    }
                    return JSON.parse(raw);
                } catch (e) {
                    return null;
                }
            }

            function writeLock() {
                localStorage.setItem(lockKey, JSON.stringify({ tabId: tabId, ts: now() }));
            }

            function isLockStale(lock) {
                if (!lock) {
                    return true;
                }
                return (now() - (lock.ts || 0)) > STALE_MS;
            }

            function ownsLock(lock) {
                return !!(lock && lock.tabId === tabId);
            }

            function showMultiTabBlock() {
                if (isBlocked) {
                    return;
                }
                isBlocked = true;
                isOwner = false;
                window.gpCheckoutTabBlocked = true;

                try {
                    $('.modal').not('#customMessageModal').modal('hide');
                } catch (e) { }

                if (!$('#gpTabLockOverlay').length) {
                    $('body').append(
                        '<div id="gpTabLockOverlay" style="position:fixed;inset:0;z-index:20000;background:rgba(0,0,0,0.55);display:flex;align-items:center;justify-content:center;padding:24px;">' +
                        '<div style="max-width:480px;width:100%;background:#fff;padding:28px 24px;text-align:center;box-shadow:0 8px 24px rgba(0,0,0,.25);">' +
                        '<h5 style="margin:0 0 16px;">Message</h5>' +
                        '<p style="margin:0;font-size:16px;line-height:1.45;">' + BLOCK_MSG + '</p>' +
                        '</div></div>'
                    );
                }

                try {
                    $('#customMessageModalMessage').html(BLOCK_MSG);
                    $('#customMessageModal').modal({ backdrop: false, keyboard: false, show: true });
                } catch (e) { }

                $('.left-menu, .content-wrapper, .tab-content, .menu, .room-bg')
                    .css('pointer-events', 'none');
                $('a, button, input, select, textarea, .tabs, .moveNext, .movePrev')
                    .css('pointer-events', 'none')
                    .attr('disabled', true)
                    .addClass('disabled');
            }

            function releaseLock() {
                try {
                    var lock = readLock();
                    if (ownsLock(lock)) {
                        localStorage.removeItem(lockKey);
                    }
                    if (channel) {
                        channel.postMessage({ type: 'release', tabId: tabId });
                    }
                } catch (e) { }
                isOwner = false;
            }

            function becomeOwner() {
                writeLock();
                isOwner = true;
                isBlocked = false;
                window.gpCheckoutTabBlocked = false;
                if (channel) {
                    channel.postMessage({ type: 'acquired', tabId: tabId });
                }
            }

            function tryClaim(allowTakeoverReload) {
                try {
                    var lock = readLock();
                    if (ownsLock(lock)) {
                        writeLock();
                        isOwner = true;
                        return true;
                    }
                    if (!lock || isLockStale(lock)) {
                        becomeOwner();
                        if (allowTakeoverReload && $('#gpTabLockOverlay').length) {
                            window.location.reload();
                            return true;
                        }
                        return true;
                    }
                    showMultiTabBlock();
                    return false;
                } catch (e) {
                    return true;
                }
            }

            function startHeartbeat() {
                if (heartbeatTimer) {
                    return;
                }
                heartbeatTimer = setInterval(function () {
                    if (!isOwner || isBlocked) {
                        return;
                    }
                    try {
                        var lock = readLock();
                        if (ownsLock(lock)) {
                            writeLock();
                        } else if (!lock || isLockStale(lock)) {
                            becomeOwner();
                        } else {
                            showMultiTabBlock();
                        }
                    } catch (e) { }
                }, HEARTBEAT_MS);
            }

            function startWatcher() {
                if (watchTimer) {
                    return;
                }
                watchTimer = setInterval(function () {
                    if (isOwner && !isBlocked) {
                        return;
                    }
                    tryClaim(true);
                }, HEARTBEAT_MS);
            }

            tryClaim(false);
            startHeartbeat();
            startWatcher();

            if (channel) {
                channel.onmessage = function (ev) {
                    if (!ev || !ev.data) {
                        return;
                    }
                    if (ev.data.type === 'release' && ev.data.tabId !== tabId) {
                        tryClaim(true);
                    }
                    if (ev.data.type === 'acquired' && ev.data.tabId !== tabId && !isOwner) {
                        showMultiTabBlock();
                    }
                };
            }

            window.addEventListener('storage', function (e) {
                if (e.key !== lockKey) {
                    return;
                }
                if (!e.newValue) {
                    tryClaim(true);
                    return;
                }
                try {
                    var lock = JSON.parse(e.newValue);
                    if (lock && lock.tabId !== tabId) {
                        showMultiTabBlock();
                    }
                } catch (ex) {
                    if (e.newValue !== tabId) {
                        showMultiTabBlock();
                    }
                }
            });

            function onPageExit() {
                if (heartbeatTimer) {
                    clearInterval(heartbeatTimer);
                    heartbeatTimer = null;
                }
                releaseLock();
            }

            window.addEventListener('pagehide', onPageExit);
            window.addEventListener('beforeunload', onPageExit);
            document.addEventListener('visibilitychange', function () {
                if (!document.hidden && isOwner && !isBlocked) {
                    try {
                        var lock = readLock();
                        if (ownsLock(lock) || !lock || isLockStale(lock)) {
                            writeLock();
                            isOwner = true;
                        } else {
                            showMultiTabBlock();
                        }
                    } catch (e) { }
                }
            });
        })();


    </script>

}
