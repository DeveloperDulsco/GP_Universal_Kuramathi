                                    <div class="col-md-4 offset-md-4">
                                        <div class="sign" id="signbox" style="display:none">
                                            <div id="signature-pad" class="signature-pad">
                                                <div class="signature-pad--body">
                                                    <canvas></canvas>
                                                </div>
