                data: {
                    "CountryID": countryID
                },
                type: "GET",
                dataType: "json",
                success: function (data) {
                    var state = $('select.state');
                    $(state).find('option').remove().end();
                    $(state).append("<option>Select State</option>");
                    $(data).each(function (i, obj) {
                        $(state).append("<option value='" + obj.StateMasterID + "'>" + obj.Statename + "</option>");
