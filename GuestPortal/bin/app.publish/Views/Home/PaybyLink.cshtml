                                        if (Model.TotalRoomRate > 0)
                                        {

                                            totalcharge = "EUR " + Model.TotalRoomRate.ToString("0.00");

                                        }
                                    }


                                    <span id="spanTotalCharges">@totalcharge </span><span>@CultureHelper.GetCultureLabel("(Inclusive of 10 % service charge and prevailing government taxes)")</span>
                                </div>
                            </div>


                        </div>
                        <div class="col-xl-5 sign-here">

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="receviceUpdate" name="checkbox1">
                                <label class="form-check-label" for="receviceUpdate">
                                    @CultureHelper.GetCultureLabel("I would like to receive marketing information from Novotel Paris Vaugirard* related to our services, including dedicated offers and promotions, on the provided email address or by sms to a given mobile phone number.")
                                </label>

                            </div>
                            <div class="form-check">
                                <label class="form-check-label" for="acceptTermsAndCondition"> @CultureHelper.GetCultureLabel("Please be informed, that by completing this pre-arrival registration you also accept our") <a style="color: #1e22aa" href="~/Resources/Customers_Privacy_Policy.pdf" target="_blank">@CultureHelper.GetCultureLabel("Customers Privacy Policy")</a> @CultureHelper.GetCultureLabel("which includes all relevant information regarding processing of your personal data by our hotel.")</label>
                            </div>
                            <div class="form-check">
                                <label class="form-check-label" for="acceptTermsAndCondition">
                                    @CultureHelper.GetCultureLabel("Please be informed, that by completing this pre-arrival registration you also accept hotels regulations that might apply to your stay depending on a hotel you choose. For any further information with this regard, please contact with a reception desk of hotel your are staying with.")
                                </label>
                            </div>

                            @*<div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkFine" name="checkbox2">
                                    <label class="form-check-label" for="chkFine">
                                        <font color="red">*</font> The hotel is a smoke-free hotel. A cleaning fee of S$275 nett per incident will be charged to a guest smoking in the room and/or within the hotel premises.</a>
                                    </label>
                                </div>*@

                            @*<div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="IsTermsAndConditionAccepted" name="IsTermsAndConditionAccepted" value="True">
                                    <label class="form-check-label" for="acceptTermsAndCondition">
                                        <font color="red">*</font> I agree to the <a href="#" data-toggle="modal" data-target="#termsAndConditionModal">terms and conditions</a>
                                    </label>
                                </div>*@
                            <div class="sign1" style="max-width;width:auto">
                                <div id="signature-pad" class="signature-pad">
                                    <div class="signature-pad--body">
                                        <canvas></canvas>
                                    </div>
                                    <div class="signature-pad--footer">
                                        <div class="signature-pad--actions">
                                            <div class="buttons">
                                                <button type="button" class="button clear" data-action="clear">@CultureHelper.GetCultureLabel("Clear")</button>
                                            </div>
                                            <div class="description">@CultureHelper.GetCultureLabel("Sign above")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="row">
