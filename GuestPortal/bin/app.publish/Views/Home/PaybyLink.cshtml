@using CheckinPortal.Helpers;
@model CheckinPortal.Models.ReservationModel
@{
    var ProfileList = (List<CheckinPortal.Models.Profile>)Model.Profiles;
    var primaryProfile = ProfileList[0];

    var PackageList = (List<CheckinPortal.Models.PackageMasterModal>)ViewBag.PackageList;

    var PackageListForRoomUpsell = PackageList.Where(x => x.IsRoomUpsell).ToList();
    var PackageListForSpecials = PackageList.Where(x => x.IsRoomUpsell == false).ToList();

    string RoomUpsellPackages = ViewBag.RoomUpsellPackages;
    string SpecialPackages = ViewBag.SpecialPackages;

}



<script>
        var AdaptorAPIBaseURL = "@ViewBag.AdaptorAPIBaseURL";
        ReservationNumber = "@Model.ReservationNumber"
        ReservationNameID = "@Model.ReservationNameID"
        var IsDepositAvailable = "@Model.IsDepositAvailable";
        var TotalRoomRate = "@Model.TotalRoomRate";
        var TotalSpecialCharges = 0;
        var selectedUpsellPackage = [];
    var selectedSpecialPackage = [];
    var language = "@(Request.Cookies.AllKeys.Contains("culture") ? @Request.Cookies["culture"].Value : "en")";


        selectedUpsellPackage = "@RoomUpsellPackages".split(",")
        selectedSpecialPackage = "@SpecialPackages".split(",")


        selectedUpsellPackage = selectedUpsellPackage.filter(function (value, index, arr) {
            return value != "";
        });

        selectedSpecialPackage = selectedSpecialPackage.filter(function (value, index, arr) {
            return value != "";
        });

</script>

<style>
    .adyen-checkout__button__text {
        width: 100% !important;
    }
</style>


<link href="~/assets/css/bootstrap-datepicker.css" rel="stylesheet" />

<link href="~/assets/css/additionalStyles.css" rel="stylesheet" />
<div class="fxd-tab">
    <div class="container">
        <div class="steps-wrap">
            <div class="row">
                <div class="col">
                    <a class="d-flex justify-content-center active tabs @(ViewBag.PaymentProcessed ? "paymentdone active " : "")" href="#guestDetails">
                        <div class="count">
                            <span class="number">1</span><span class="value">@CultureHelper.GetCultureLabel("GUEST DETAILS")</span>
                        </div>
                    </a>
                </div>
                <div class="col">
                    <a class="d-flex justify-content-center tabs @(ViewBag.PaymentProcessed ? "paymentdone active" : "")" href="#upgrade" style="display:none;">
                        <div class="count">
                            <span class="number">2</span><span class="value">@CultureHelper.GetCultureLabel("Upgrade")</span>
                        </div>
                    </a>
                </div>
                <div class="col">
                    <a class="d-flex justify-content-center tabs @(ViewBag.PaymentProcessed ? "paymentdone active" : "")" href="#policies">
                        <div class="count">
                            <span class="number">3</span><span class="value">@CultureHelper.GetCultureLabel("Policies")</span>
                        </div>
                    </a>
                </div>
                <div class="col">
                    <a class="d-flex justify-content-center tabs @((ViewBag.PaymentProcessed && ViewBag.IsPaymentSuccess) ? "paymentdone active" : "")" href="#payment">
                        <div class="count">
                            <span class="number">4</span><span class="value">@CultureHelper.GetCultureLabel("Payment")</span>
                        </div>
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="layout">
    <div class="container">
        <div class="tab-content">
            <div class="tab-pane content-wrapper cstm-form @(ViewBag.PaymentProcessed ? "paymentdone" : "active") " id="guestDetails">
                <form id="frm_guestdetails" name="frm_guestdetails">

                    @Html.HiddenFor(model => model.ReservationID)
                    @Html.HiddenFor(model => model.AdultCount)
                    @Html.HiddenFor(model => model.ChildCount)
                    @Html.HiddenFor(model => model.ReservationNumber)
                    @if (Model.Profiles.Count > 0)
                    {
                        @Html.HiddenFor(model => model.Profiles[0].ProfileDetailID)
                        @Html.HiddenFor(model => model.Profiles[0].ProfileID)
                    }
                    @if (Model.Profiles.Count > 1)
                    {
                        @Html.HiddenFor(model => model.Profiles[1].ProfileDetailID)
                        @Html.HiddenFor(model => model.Profiles[1].ProfileID)
                    }
                    @if (Model.Profiles.Count > 2)
                    {
                        @Html.HiddenFor(model => model.Profiles[2].ProfileDetailID)
                        @Html.HiddenFor(model => model.Profiles[2].ProfileID)
                    }

                    <h1>@CultureHelper.GetCultureLabel("GUEST DETAILS")</h1>
                    <div class="detail-wrapper">
                        <ul>
                            <li>
                                <label>@CultureHelper.GetCultureLabel("ROOM TYPE")</label>
                                <span>@Model.RoomTypeDescription</span>
                            </li>
                            <li>
                                <label>@CultureHelper.GetCultureLabel("CHECK-IN DATE")</label>
                                <span>@Model.ArrivalDate</span>
                            </li>
                            <li>
                                <label>@CultureHelper.GetCultureLabel("CHECK-OUT DATE")</label>
                                <span>@Model.DepartureDate</span>@*02 June 2020*@
                            </li>
                            <li>
                                <label>@CultureHelper.GetCultureLabel("Adult/Child")</label>
                                <span>@Model.AdultCount / @Model.ChildCount</span>
                            </li>
                        </ul>
                    </div>
                    <!-- details -->
                    <h2>@CultureHelper.GetCultureLabel("Personal Information")</h2>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("Email  Address") <span class="error">*</span></label>


                            @Html.TextBoxFor(model => model.Profiles[0].Email, new { @class = "form-control", type = "email" })
                            @*<input type="email" class="form-control" value="@primaryProfile.Email" id="email" name="Profile[0].Email">*@
                        </div>
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("Phone Number") <span class="error">*</span></label>
                            @*@Html.TextBoxFor(model => model.Profiles[0].Phone, new { @class = "form-control", type = "number" })*@
                            <input type="text" class="form-control" id="phone" name="Profiles[0].Phone" value="@primaryProfile.Phone">
                        </div>
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("Address") <span class="error">*</span></label>
                            @Html.TextBoxFor(model => model.Profiles[0].AddressLine1, new { @class = "form-control" })
                            @*<input type="text" class="form-control" id="address" name="Profile[0].AddressLine1" value="@primaryProfile.AddressLine1">*@
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("Country")  <span class="error">*</span></label>
                            @Html.DropDownListFor(model => model.Profiles[0].CountryID, (SelectList)ViewBag.CountryList, "Select Country", new { @class = "form-control selectpicker selectCountry", @data_live_search = "true" })

                        </div>
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("State")  <span class="error"></span></label>
                            @Html.DropDownListFor(model => model.Profiles[0].StateID, (SelectList)ViewBag.StateList, "Select State", new { @class = "form-control selectpicker state", @data_live_search = "true" })

                            @*<select class="selectpicker form-control" id="state" name="state"></select>*@
                        </div>
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("City")  <span class="error">*</span></label>
                            @Html.TextBoxFor(model => model.Profiles[0].City, new { @class = "form-control" })
                            @*<input type="text" class="form-control" id="city" name="city" @Model.Profiles[0].City>*@
                        </div>

                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("Postal code")  <span class="error">*</span></label>
                            @Html.TextBoxFor(model => model.Profiles[0].PostalCode, new { @class = "form-control", value = "1212" })
                            @*<input type="text" class="form-control" id="postalcode" name="postalcode" value="@primaryProfile.PostalCode">*@
                        </div>
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("ALL Membership Number")<a class="info" href="#" data-toggle="tooltip" title="Accor Live Limitless membership no."></a></label>
                            @Html.TextBoxFor(model => model.MembershipNo, new { @class = "form-control", onchange = "enableDisableMembershipCheckbox()" })
                            @*<input type="text" class="form-control" value="@Model.MembershipNo" id="membershipno" name="membershipno">*@
                        </div>
                        <!--<div class="form-group col-md-4">
                        <div class="form-check chk-cu">
                            @Html.CheckBoxFor(model => model.IsMembershipRequested, new { @class = "form-check-input", onchange = "enableDisableMembership(this.checked)" })-->
                        @*<input class="form-check-input" @( !string.IsNullOrEmpty(Model.MembershipNo) ? "disabled" : "") type="checkbox" onchange="enableDisableMembership(this.checked)" id="joinmembership" name="joinmembership">*@
                        <!--<label class="form-check-label" for="IsMembershipRequested">
                                    I would like to receive an invitation on the ALL membership program.
                                </label>
                            </div>
                        </div>-->
                        <div class="form-group col-md-4 time-cstm">
                            <label>@CultureHelper.GetCultureLabel("Expected Arrival Time (Hotel)") <span class="error">*</span></label>
                            @Html.TextBoxFor(model => model.ExpectedTimeofArrival, new { @class = "form-control", id = "timepicker1", type = "time" })
                            @*<span>Hotel Check In Time is 03.00pm</span>*@
                            @*<input type="time" id="timepicker1" class="form-control" name="expected_arrival" value="@Model.ExpectedTimeofArrival">*@
                        </div>
                    </div>

                    <h2>@CultureHelper.GetCultureLabel("Document Details")</h2>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("Nationality")  <span class="error">*</span></label>
                            @Html.DropDownListFor(model => model.Profiles[0].NationnalityID, (SelectList)ViewBag.NationalityList, "Select Nationality", new { @class = "form-control selectpicker selectNationality", @data_live_search = "true" })

                        </div>
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("Passport Number") <span class="error" style="display:none">*</span></label>
                            @*@Html.TextBoxFor(model => model.Profiles[0].Phone, new { @class = "form-control", type = "number" })*@
                            <input type="text" class="form-control" id="passportnumber" name="Profiles[0].DocumentNumber">
                        </div>
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("Expiry Date") <span class="error" style="display:none">*</span></label>
                            <div class="date-icon">
                                <span class="icon-append"><i class="far fa-calendar-alt"></i></span>
                                <input type="text" placeholder="DD/MM/YYYY" class="form-control py-3 datepicker" id="ExpiryDate" name="Profiles[0].ExpiryDate">
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label>@CultureHelper.GetCultureLabel("Place Of Issue") <span class="error" style="display:none">*</span></label>
                            @*@Html.TextBoxFor(model => model.Profiles[0].Phone, new { @class = "form-control", type = "number" })*@
                            <input type="text" class="form-control" id="placeofissue" name="Profiles[0].placeofissue">
                        </div>
                        <div class="form-group col-md-4">
                            <label>
                                @CultureHelper.GetCultureLabel("Date Of Birth")
                                <span class="error" style="display:none">*</span>
                            </label>
                            @*@Html.TextBoxFor(model => model.Profiles[0].Phone, new { @class = "form-control", type = "number" })*@

                            <div class="date-icon">
                                <span class="icon-append"><i class="far fa-calendar-alt"></i></span>
                                <input type="text" placeholder="DD/MM/YYYY" class="form-control py-3 datepicker" id="DateOfBirth" name="Profiles[0].DateOfBirth">
                            </div>
                        </div>
                        <div class="form-group col-md-4">
                            <label>
                                @CultureHelper.GetCultureLabel("Place Of Birth")
                                <span class="error" style="display:none">*</span>
                            </label>
                            @*@Html.TextBoxFor(model => model.Profiles[0].Phone, new { @class = "form-control", type = "number" })*@

                            <input type="text" class="form-control" id="PlaceOfBirth" name="Profiles[0].PlaceOfBirth">
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <div class="form-check chk-cu">
                                @Html.CheckBoxFor(model => model.IsMembershipRequested, new { @class = "form-check-input", onchange = "enableDisableMembership(this.checked)" })

                                <label class="form-check-label" for="gridCheck">
                                    @CultureHelper.GetCultureLabel("Enrollment Message")
                                </label>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-xl-4 offset-xl-8 offset-lg-6">
                            <div class="btn-grp d-flex justify-content-between">
                                @*<button class="btn_cancel">@CultureHelper.GetCultureLabel("Back")</button>*@
                                <button type="button" class="btn_next " onclick="SaveReservationAndMoveNext(this)">@CultureHelper.GetCultureLabel("Next")<img src="~/assets/images/arrow_icon.png"></button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="tab-pane content-wrapper cstm-form  @(ViewBag.PaymentProcessed ? "paymentdone" : "") " id="upgrade">
                <h1>@CultureHelper.GetCultureLabel("Upgrade")</h1>
                @if (PackageListForRoomUpsell != null && PackageListForRoomUpsell.Count > 0)
                {
                    <h2>@CultureHelper.GetCultureLabel("AVAILABLE ROOM UPGRADE")</h2>
                }
                @*<span style="text-transform:none">(Subject to availability)</span>*@
                <div class="row">
                    @foreach (var package in PackageListForRoomUpsell)
                    {
                        var url = $"data:image/png;base64,{Convert.ToBase64String(package.PackageImage)}";
                        var isUpsellSelected = ((List<CheckinPortal.Models.ReservationPackageModel>)ViewBag.ReservationPackagesList).Any(x => x.PackageID == package.PackageID);


                        <div class="col-md-6 col-lg-4 col-xl-3 @package.PackageID">
                            <div class="upg-wrap">
                                <div class="upgrade">
                                    <span class="tick" data-upselltype="Upsell" style="display:@(isUpsellSelected ? "block" : "none")"></span>
                                    <img class="img-fluid" src="@url">
                                </div>
                                <div class="btn-wrap" style="height:120px">
                                    <div class="row">
                                        <div class="col"><label>@package.PackageName</label> </div>
                                        <div class="col-auto">
                                            <a href="#/" class="selectUpsell" onclick="showUpsellPopup(this,'Upsell')">@CultureHelper.GetCultureLabel("DETAILS")</a>
                                            <input type="hidden" value="@package.PackageName" class="upsellPackageName" />
                                            <input type="hidden" value="@url" class="upsellImage" />
                                            <input type="hidden" value="@package.PackageAmount" class="packageAmount" />
                                            <input type="hidden" value="@package.PackageCode" class="packageCode" />
                                            <input type="hidden" value="@package.PackageDesc" class="packageDesc" />
                                            <input type="hidden" value="@package.PackageID" class="packageID" />
                                            <input type="hidden" value="@package.Units" class="packageUnits" />
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>
                @if (PackageListForSpecials != null && PackageListForSpecials.Count > 0)
                {
                    <h2>@CultureHelper.GetCultureLabel("Specials") @*<span style="text-transform:none">(Instant confirmation)</span>*@</h2>
                }
                <div class="row">

                    @foreach (var package in PackageListForSpecials)
                    {
                        string url = string.Empty;
                        if (package.PackageImage != null)
                        {
                            url = $"data:image/png;base64,{Convert.ToBase64String(package.PackageImage)}";
                        }

                        var isUpsellSelected = ((List<CheckinPortal.Models.ReservationPackageModel>)ViewBag.ReservationPackagesList).Any(x => x.PackageID == package.PackageID);

                        <div class="col-md-6 col-lg-4 col-xl-3 @package.PackageID">
                            <div class="upg-wrap">
                                <div class="upgrade">
                                    <span class="tick" data-upselltype="Package" style="display:@(isUpsellSelected ? "block" : "none")"></span>
                                    <img class="img-fluid" src="@url">
                                </div>
                                <div class="btn-wrap" style="height:120px">
                                    <div class="row">
                                        <div class="col"><label>@package.PackageName</label> </div>
                                        <div class="col-auto">
                                            <a href="#/" class="selectUpsell" onclick="showUpsellPopup(this,'Package')">@CultureHelper.GetCultureLabel("DETAILS")</a>
                                            <input type="hidden" value="@package.PackageName" class="upsellPackageName" />
                                            <input type="hidden" value="@url" class="upsellImage" />
                                            <input type="hidden" value="@package.PackageAmount" class="packageAmount" />
                                            <input type="hidden" value="@package.PackageCode" class="packageCode" />
                                            <input type="hidden" value="@package.PackageDesc" class="packageDesc" />
                                            <input type="hidden" value="@package.PackageID" class="packageID" />
                                            <input type="hidden" value="@package.Units" class="packageUnits" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="message" id="upgradeTerms" style="display:none">
                    @CultureHelper.GetCultureLabel("The selected upgrade option is subject to availability at the time of reservation. Our team will be in touch shortly to confirm.")<br />
                    @*<div>
                            <input type="checkbox" value="1" id="upgradeTermsCheckbox" /> By checking this box, I acknowledge and agree for my credit card to be charged the additional fees should my requested room upgrade be available.
                        </div>*@
                </div>

                <div class="message" id="upgradeTermsSpecials" style="display:none">
                    @CultureHelper.GetCultureLabel("Request for Specials is confirmed instantly and your card will be charged in the next page.")<br />
                </div>

                <div class="row">
                    <div class="col-lg-6 col-xl-4 offset-xl-8 offset-lg-6">
                        <div class="btn-grp d-flex justify-content-between">
                            <button class="btn_cancel" value='Back'>@CultureHelper.GetCultureLabel("Back")</button>
                            <button class="btn_next " onclick="savePackages(this)">@CultureHelper.GetCultureLabel("Next")<img src="~/assets/images/arrow_icon.png"></button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-pane content-wrapper cstm-form @(ViewBag.PaymentProcessed ? "paymentdone" : "") " id="policies">

                <h1>Policies</h1>
                @*<h2 class="mb-none">Policies</h2>*@
                <div class="plcy-wrapper">
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="form-group row">
                                <label class="col-7 col-lg-4 col-xl-4">@CultureHelper.GetCultureLabel("CONFIRMATION NUMBER")</label>
                                <div class="col-5 col-lg-8 col-xl-8">
                                    <span>@Model.ReservationNumber</span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-7 col-lg-4 col-xl-4">@CultureHelper.GetCultureLabel("ROOM TYPE")</label>
                                <div class="col-5 col-lg-8 col-xl-8">
                                    <span>@Model.RoomTypeDescription</span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-7 col-lg-4 col-xl-4">@CultureHelper.GetCultureLabel("CHECK-IN DATE")</label>
                                <div class="col-5 col-lg-8 col-xl-8">
                                    <span>@Model.ArrivalDate</span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-7 col-lg-4 col-xl-4">@CultureHelper.GetCultureLabel("CHECK-OUT DATE")</label>
                                <div class="col-5 col-lg-8 col-xl-8">
                                    <span>@Model.DepartureDate</span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-7 col-lg-4 col-xl-4">@CultureHelper.GetCultureLabel("Adult/Child")</label>
                                <div class="col-5 col-lg-8 col-xl-8">
                                    <span>@Model.AdultCount / @Model.ChildCount</span>
                                </div>
                            </div>

                            @*<div class="form-group row">
                                    <label class="col-7 col-lg-4 col-xl-4">Avg. Room Rate </label>
                                    <div class="col-5 col-lg-8 col-xl-8">
                                        <span> @Model.AverageRoomRate.ToString("0.00") £ </span>
                                    </div>
                                </div>*@
                            <div class="form-group row">
                                <label class="col-7 col-lg-4 col-xl-4">@CultureHelper.GetCultureLabel("BREAKFAST")</label>
                                <div class="col-5 col-lg-8 col-xl-8">
                                    <span>@(Model.IsBreakFastAvailable ? @CultureHelper.GetCultureLabel("Included") : @CultureHelper.GetCultureLabel("Not Included"))</span>
                                </div>
                            </div>
                            <hr>
                            <div class="form-group row total">
                                <label class="col-7 col-lg-4 col-xl-4">@CultureHelper.GetCultureLabel("TOTAL ROOM CHARGES")</label>
                                <div class="col-5 col-lg-8 col-xl-8">

                                    @{
